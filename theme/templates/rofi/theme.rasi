/* Generated by rice-theme from theme/templates/rofi/theme.rasi. Edit the template, not this file. */
* {
    bg: #${BG}; surface: #${SURFACE}; border-col: #${BORDER};
    fg: #${TEXT}; muted: #${MUTED}; accent: #${ACCENT};
    background-color: transparent; text-color: @fg;
    font: "Maple Mono NF 11";
}
window { background-color: @bg; border: 1px; border-color: @border-col; border-radius: 8px; width: 36%; padding: 12px; }
mainbox { children: [ inputbar, listview ]; spacing: 10px; }
inputbar { background-color: @surface; border-radius: 6px; padding: 8px 12px; spacing: 10px; children: [ prompt, entry ]; }
prompt { text-color: @muted; }
entry { placeholder: "Search"; placeholder-color: @muted; }
listview { lines: 8; scrollbar: false; }
element { padding: 6px 10px; spacing: 10px; border-radius: 6px; }
element selected.normal { background-color: @surface; text-color: @fg; }
element-icon { size: 22px; }
element-text { vertical-align: 0.5; }
