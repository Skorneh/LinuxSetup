# Generated by rice-theme from theme/templates/dunst/dunstrc. Edit the template, not this file.
[global]
    font = Maple Mono NF 10
    origin = bottom-right
    offset = (12, 48)
    width = 320
    frame_width = 1
    corner_radius = 6
    padding = 10
    horizontal_padding = 12
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    max_icon_size = 32

[urgency_low]
    background = "#${BG}"
    foreground = "#${MUTED}"
    frame_color = "#${BORDER}"
    timeout = 4

[urgency_normal]
    background = "#${BG}"
    foreground = "#${TEXT}"
    frame_color = "#${ACCENT}"
    timeout = 6

[urgency_critical]
    background = "#${BG}"
    foreground = "#${TEXT}"
    frame_color = "#${URGENT}"
    timeout = 0
