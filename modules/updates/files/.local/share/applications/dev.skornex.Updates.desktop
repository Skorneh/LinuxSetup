[Desktop Entry]
# SkorneX Settings module (updates). Named after the window's app ID so the
# taskbar and title bar find its icon.
Type=Application
Name=Updates
Comment=See and install updates for apps, the system and SkorneX.
Exec=skornex-updates
Icon=system-software-update
StartupWMClass=dev.skornex.Updates
Categories=Settings;
Keywords=update;upgrade;software;packages;
