[Desktop Entry]
# SkorneX Settings module (personalize). Named after the window's app ID so the
# taskbar and title bar find its icon.
Type=Application
Name=Personalize
Comment=Color themes, accent color and desktop wallpaper.
Exec=skornex-personalize
Icon=preferences-desktop-wallpaper
StartupWMClass=dev.skornex.Personalize
Categories=Settings;
Keywords=personalize;colors;theme;accent;wallpaper;background;
