[Desktop Entry]
# SkorneX Settings module (shortcuts). Named after the window's app ID so the
# taskbar and title bar find its icon.
Type=Application
Name=Keyboard shortcuts
Comment=Change, turn off or add keyboard shortcuts.
Exec=skornex-shortcuts
Icon=preferences-desktop-keyboard-shortcuts
StartupWMClass=dev.skornex.Shortcuts
Categories=Settings;
Keywords=shortcuts;hotkeys;keybindings;keys;
