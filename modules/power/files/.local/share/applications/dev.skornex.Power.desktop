[Desktop Entry]
# SkorneX Settings module (power). Named after the window's app ID so the
# taskbar and title bar find its icon.
Type=Application
Name=Power settings
Comment=When the screen locks, turns off and the PC sleeps; the power button and the lid.
Exec=skornex-power
Icon=preferences-system-power
StartupWMClass=dev.skornex.Power
Categories=Settings;
Keywords=power;sleep;suspend;lock;screen;idle;lid;battery;timeout;
