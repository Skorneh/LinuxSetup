[Desktop Entry]
# SkorneX Settings module (display). Named after the window's app ID so the
# taskbar and title bar find its icon.
Type=Application
Name=Display settings
Comment=Resolution, refresh rate, scale, orientation and monitor layout.
Exec=skornex-display
Icon=preferences-desktop-display
StartupWMClass=dev.skornex.Display
Categories=Settings;
Keywords=display;screen;monitor;resolution;scale;refresh;rotate;
