#!/usr/bin/env python3
"""SkorneX Display settings: resolution, refresh rate, scale, orientation and
where each monitor sits, like Windows' Display settings.

    skornex-display     open it on its own (or search "Display settings")

It's also a page in Settings (skornex-settings). Changes ask "Keep these
display settings?" and go back on their own after 15 seconds if you can't
see the screen. Kept settings are saved in ~/.config/skornex/autostart.d/display
and applied every time you log in.
"""

import json
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

TITLE = "Display"
ICON = "preferences-desktop-display"
APP_ID = "dev.skornex.Display"

SAVED = os.path.expanduser("~/.config/skornex/autostart.d/display")
SCALES = [1.0, 1.25, 1.5, 1.75, 2.0]
ORIENTATIONS = [("normal", "Landscape"), ("90", "Portrait"),
                ("180", "Landscape (flipped)"), ("270", "Portrait (flipped)")]
REVERT_SECONDS = 15


def read_outputs():
    try:
        out = subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, timeout=5).stdout
        return json.loads(out or "[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        return []


def state_of(output):
    """The settings we change, as a plain dict."""
    current = next((m for m in output.get("modes", []) if m.get("current")), None)
    pos = output.get("position") or {}
    return {
        "enabled": output.get("enabled", True),
        "mode": (current["width"], current["height"], current["refresh"]) if current else None,
        "scale": float(output.get("scale") or 1.0),
        "transform": output.get("transform") or "normal",
        "pos": (pos.get("x", 0), pos.get("y", 0)),
    }


def logical_size(state):
    """Size on the desktop, in whole pixels, rounded down like labwc does, so
    monitors placed side by side touch with no gap."""
    w, h, _ = state["mode"]
    w, h = int(w / state["scale"]), int(h / state["scale"])
    return (h, w) if state["transform"] in ("90", "270") else (w, h)


def overlaps(a, b):
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    return ax < bx + bw and bx < ax + aw and ay < by + bh and by < ay + ah


def snap(rect, others):
    """Moves a monitor to the nearest spot touching another one edge to edge
    (no gap, no overlap), lining it up with that monitor's top, bottom or
    middle when it's close."""
    x, y, w, h = rect
    if not others:
        return 0, 0
    best, best_dist = None, None
    for ox, oy, ow, oh in others:
        for side in ("left", "right", "above", "below"):
            if side in ("left", "right"):
                nx = ox - w if side == "left" else ox + ow
                # Keep at least a stretch of shared edge so the mouse can cross.
                share = min(h, oh) // 4
                ny = max(oy - h + share, min(y, oy + oh - share))
                for line_up in (oy, oy + oh - h, oy + (oh - h) // 2):
                    if abs(ny - line_up) <= h // 10:
                        ny = line_up
                        break
            else:
                ny = oy - h if side == "above" else oy + oh
                share = min(w, ow) // 4
                nx = max(ox - w + share, min(x, ox + ow - share))
                for line_up in (ox, ox + ow - w, ox + (ow - w) // 2):
                    if abs(nx - line_up) <= w // 10:
                        nx = line_up
                        break
            if any(overlaps((nx, ny, w, h), o) for o in others):
                continue
            dist = (nx - x) ** 2 + (ny - y) ** 2
            if best_dist is None or dist < best_dist:
                best, best_dist = (nx, ny), dist
    return best or (x, y)


MAIN_FILE = os.path.expanduser("~/.config/skornex/main-display")


def read_main():
    try:
        with open(MAIN_FILE) as f:
            return f.read().strip()
    except OSError:
        return ""


class Arrangement(Gtk.DrawingArea):
    """The monitors as boxes: drag one next to another, it snaps edge to edge."""

    def __init__(self, page):
        super().__init__()
        self.page = page
        self.set_size_request(-1, 220)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_press)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("button-release-event", self.on_release)
        self.drag = None
        self.view = (1.0, 0, 0)  # scale, offset x, offset y

    def rects(self):
        return {name: (*s["pos"], *logical_size(s)) for name, s in self.page.states.items()
                if s["enabled"] and s["mode"]}

    def on_draw(self, _w, cr):
        rects = self.rects()
        if not rects:
            return
        width, height = self.get_allocated_width(), self.get_allocated_height()
        if not self.drag:  # keep the view still while dragging
            x0 = min(r[0] for r in rects.values())
            y0 = min(r[1] for r in rects.values())
            x1 = max(r[0] + r[2] for r in rects.values())
            y1 = max(r[1] + r[3] for r in rects.values())
            scale = min((width - 40) / max(1, x1 - x0), (height - 40) / max(1, y1 - y0))
            self.view = (scale, (width - (x1 - x0) * scale) / 2 - x0 * scale,
                         (height - (y1 - y0) * scale) / 2 - y0 * scale)
        scale, ox, oy = self.view
        fg = self.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        for i, (name, (x, y, w, h)) in enumerate(rects.items(), 1):
            rx, ry, rw, rh = ox + x * scale, oy + y * scale, w * scale, h * scale
            dragging = self.drag and self.drag[0] == name
            cr.set_source_rgba(0.35, 0.55, 0.95, 0.55 if dragging else 0.35)
            cr.rectangle(rx + 1, ry + 1, rw - 2, rh - 2)
            cr.fill_preserve()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.8)
            cr.set_line_width(1.5)
            cr.stroke()
            text = f"{i}  {name}" + ("  ★ main" if name == self.page.main else "")
            cr.set_font_size(13)
            ext = cr.text_extents(text)
            cr.move_to(rx + (rw - ext.width) / 2, ry + rh / 2 + ext.height / 2)
            cr.show_text(text)

    def at(self, ex, ey):
        scale, ox, oy = self.view
        for name, (x, y, w, h) in self.rects().items():
            if ox + x * scale <= ex <= ox + (x + w) * scale and oy + y * scale <= ey <= oy + (y + h) * scale:
                return name
        return None

    def on_press(self, _w, event):
        name = self.at(event.x, event.y)
        if name and len(self.rects()) > 1:
            x, y = self.page.states[name]["pos"]
            self.drag = (name, event.x, event.y, x, y)

    def on_motion(self, _w, event):
        if not self.drag:
            return
        name, sx, sy, x, y = self.drag
        scale = self.view[0]
        self.page.states[name]["pos"] = (int(x + (event.x - sx) / scale), int(y + (event.y - sy) / scale))
        self.queue_draw()

    def on_release(self, _w, _event):
        if not self.drag:
            return
        name = self.drag[0]
        self.drag = None
        rects = self.rects()
        others = [r for n, r in rects.items() if n != name]
        self.page.states[name]["pos"] = snap(rects[name], others)
        self.queue_draw()
        for child in self.page.apply_row.get_children():
            child.show()
        self.page.apply_row.show()


def command(states):
    cmd = ["wlr-randr"]
    for name, s in states.items():
        cmd += ["--output", name]
        if not s["enabled"]:
            cmd.append("--off")
            continue
        cmd.append("--on")
        if s["mode"]:
            w, h, r = s["mode"]
            cmd += ["--mode", f"{w}x{h}@{r:.6f}Hz"]
        cmd += ["--scale", f"{s['scale']:g}", "--transform", s["transform"],
                "--pos", f"{int(s['pos'][0])},{int(s['pos'][1])}"]
    return cmd


def hz(rate):
    return f"{rate:.2f}".rstrip("0").rstrip(".") + " Hz"


class Page(Gtk.Box):
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.set_border_width(24)
        title = Gtk.Label(xalign=0)
        title.set_markup(f"<span size='x-large' weight='bold'>{TITLE}</span>")
        self.pack_start(title, False, False, 0)
        self.arrangement = Arrangement(self)
        self.arrangement.set_no_show_all(True)  # only with two or more displays
        self.pack_start(self.arrangement, False, False, 0)
        # Moving monitors waits for Apply (everything else applies right away).
        self.apply_row = Gtk.Box(spacing=8)
        apply = Gtk.Button(label="Apply")
        apply.get_style_context().add_class("suggested-action")
        apply.connect("clicked", lambda _b: self.apply())
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda _b: self.load())
        self.apply_row.pack_end(apply, False, False, 0)
        self.apply_row.pack_end(cancel, False, False, 0)
        self.apply_row.set_no_show_all(True)
        self.pack_start(self.apply_row, False, False, 0)
        self.cards = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.pack_start(self.cards, False, False, 0)
        self.pending = None
        self.loading = False
        # Plugging a monitor in or out shows up here right away.
        display = Gdk.Display.get_default()
        display.connect("monitor-added", lambda *_: GLib.timeout_add(1000, self.reload))
        display.connect("monitor-removed", lambda *_: GLib.timeout_add(1000, self.reload))
        self.load()

    def reload(self):
        self.load()
        return False

    def schedule_apply(self):
        """Settings apply as soon as you change them, like on Windows."""
        if self.loading or self.pending:
            return
        self.pending = GLib.timeout_add(150, self.apply_now)

    def apply_now(self):
        self.pending = None
        self.apply()
        return False

    def load(self):
        self.loading = True
        self.apply_row.hide()
        for child in self.cards.get_children():
            child.destroy()
        self.outputs = {o["name"]: o for o in read_outputs()}
        self.states = {name: state_of(o) for name, o in self.outputs.items()}
        self.main = read_main()
        if self.main not in self.outputs:
            self.main = next(iter(self.outputs), "")
        self.main_group = None
        if not self.outputs:
            note = Gtk.Label(label="No displays found. This needs a Wayland session (labwc) and wlr-randr.",
                             xalign=0, wrap=True)
            self.cards.pack_start(note, False, False, 0)
        for name in self.outputs:
            self.cards.pack_start(self.card(name), False, False, 0)
        self.show_all()
        if len(self.outputs) > 1:
            self.arrangement.show()
            self.arrangement.queue_draw()
        else:
            self.arrangement.hide()
        self.loading = False

    def card(self, name):
        output, state = self.outputs[name], self.states[name]
        frame = Gtk.Frame()
        label = Gtk.Label(xalign=0)
        desc = output.get("description") or ""
        label.set_markup(f"<b>{GLib.markup_escape_text(name)}</b>  "
                         f"<span alpha='60%'>{GLib.markup_escape_text(desc)}</span>")
        frame.set_label_widget(label)
        grid = Gtk.Grid(row_spacing=8, column_spacing=16, margin=12)
        frame.add(grid)
        row = 0

        def add(text, widget):
            nonlocal row
            grid.attach(Gtk.Label(label=text, xalign=0), 0, row, 1, 1)
            widget.set_hexpand(True)
            grid.attach(widget, 1, row, 1, 1)
            row += 1

        if len(self.outputs) > 1:
            switch = Gtk.Switch(active=state["enabled"], halign=Gtk.Align.START)
            switch.connect("notify::active", lambda s, _p: (state.update(enabled=s.get_active()),
                                                            self.schedule_apply()))
            add("Use this display", switch)
            main = Gtk.Switch(active=name == self.main, halign=Gtk.Align.START)
            main.connect("notify::active", lambda s, _p: self.set_main(name, s))
            add("Main display", main)

        modes = output.get("modes", [])
        sizes = sorted({(m["width"], m["height"]) for m in modes}, key=lambda s: -s[0] * s[1])
        preferred = next(((m["width"], m["height"]) for m in modes if m.get("preferred")), None)
        res = Gtk.ComboBoxText()
        for w, h in sizes:
            res.append(f"{w}x{h}", f"{w} × {h}" + ("  (recommended)" if (w, h) == preferred else ""))
        rate = Gtk.ComboBoxText()

        def fill_rates():
            w, h = state["mode"][:2]
            rate.remove_all()
            rates = sorted({m["refresh"] for m in modes if (m["width"], m["height"]) == (w, h)}, reverse=True)
            for r in rates:
                rate.append(repr(r), hz(r))
            current = state["mode"][2]
            best = min(rates, key=lambda r: abs(r - current)) if rates else None
            if best is not None:
                rate.set_active_id(repr(best))

        def on_res(combo):
            if combo.get_active_id() and state["mode"]:
                w, h = map(int, combo.get_active_id().split("x"))
                state["mode"] = (w, h, state["mode"][2])
                fill_rates()
                self.schedule_apply()

        def on_rate(combo):
            if combo.get_active_id() and state["mode"]:
                state["mode"] = state["mode"][:2] + (float(combo.get_active_id()),)
                self.schedule_apply()

        if state["mode"]:
            res.set_active_id(f"{state['mode'][0]}x{state['mode'][1]}")
            fill_rates()
        res.connect("changed", on_res)
        rate.connect("changed", on_rate)
        add("Resolution", res)
        add("Refresh rate", rate)

        scale = Gtk.ComboBoxText()
        scales = sorted(set(SCALES) | {state["scale"]})
        for s in scales:
            scale.append(repr(s), f"{round(s * 100)}%" + ("  (recommended)" if s == 1.0 else ""))
        scale.set_active_id(repr(state["scale"]))
        scale.connect("changed", lambda c: (state.update(scale=float(c.get_active_id())),
                                            self.schedule_apply()))
        add("Scale (text and app size)", scale)

        orient = Gtk.ComboBoxText()
        for value, text in ORIENTATIONS:
            orient.append(value, text)
        if not orient.set_active_id(state["transform"]):
            orient.append(state["transform"], state["transform"])
            orient.set_active_id(state["transform"])
        orient.connect("changed", lambda c: (state.update(transform=c.get_active_id()),
                                             self.schedule_apply()))
        add("Orientation", orient)

        return frame

    def place(self, states):
        """Re-snaps every monitor against the ones before it (sizes may have
        changed), then moves the layout so its top-left corner is at 0,0."""
        on = sorted((n for n, st in states.items() if st["enabled"] and st["mode"]),
                    key=lambda n: (n != self.main, states[n]["pos"]))
        placed = []
        for name in on:
            rect = (*states[name]["pos"], *logical_size(states[name]))
            if placed:
                states[name]["pos"] = snap(rect, placed)
                rect = (*states[name]["pos"], rect[2], rect[3])
            placed.append(rect)
        if on:
            min_x = min(states[n]["pos"][0] for n in on)
            min_y = min(states[n]["pos"][1] for n in on)
            for n in on:
                states[n]["pos"] = (states[n]["pos"][0] - min_x, states[n]["pos"][1] - min_y)

    def apply(self):
        if not self.states:
            return
        if not any(s["enabled"] for s in self.states.values()):
            self.message("At least one display has to stay on.")
            return
        before = {name: state_of(o) for name, o in self.outputs.items()}
        after = {name: dict(s) for name, s in self.states.items()}
        self.place(after)
        if subprocess.run(command(after)).returncode != 0:
            self.message("That didn't work. The display may not support those settings.")
            subprocess.run(command(before))
            return
        if self.confirm_keep():
            self.save(after)
        else:
            subprocess.run(command(before))
        self.load()

    def set_main(self, name, switch):
        if self.loading:
            return
        if not switch.get_active():  # there's always a main display: pick another one instead
            if name == self.main:
                self.loading = True
                switch.set_active(True)
                self.loading = False
            return
        self.main = name
        os.makedirs(os.path.dirname(MAIN_FILE), exist_ok=True)
        with open(MAIN_FILE, "w") as f:
            f.write(name + "\n")
        self.save({n: state_of(o) for n, o in self.outputs.items()})
        # Games and other X11 apps open on the "primary" output.
        subprocess.run(["xrandr", "--output", name, "--primary"], stderr=subprocess.DEVNULL)
        # The taskbar and desktop restart on the main display a second later.
        subprocess.run(["pkill", "-f", r"\.local/bin/skornex-bar( desktop)?$"])
        GLib.idle_add(self.reload)

    def confirm_keep(self):
        dialog = Gtk.MessageDialog(transient_for=self.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION,
                                   text="Keep these display settings?")
        dialog.add_buttons("Revert", Gtk.ResponseType.CANCEL, "Keep changes", Gtk.ResponseType.OK)
        left = [REVERT_SECONDS]

        def tick():
            left[0] -= 1
            dialog.format_secondary_text(f"Going back to the previous settings in {left[0]} seconds.")
            if left[0] <= 0:
                dialog.response(Gtk.ResponseType.CANCEL)
                return False
            return True
        dialog.format_secondary_text(f"Going back to the previous settings in {REVERT_SECONDS} seconds.")
        timer = GLib.timeout_add_seconds(1, tick)
        answer = dialog.run()
        if left[0] > 0:
            GLib.source_remove(timer)
        dialog.destroy()
        return answer == Gtk.ResponseType.OK

    def save(self, states):
        os.makedirs(os.path.dirname(SAVED), exist_ok=True)
        with open(SAVED, "w") as f:
            f.write("#!/bin/sh\n# Made by Display settings: your screen layout, applied at login.\n")
            f.write(" ".join(GLib.shell_quote(a) for a in command(states)) + "\n")
            main = read_main()
            if main:
                # Games and other X11 apps open on the "primary" output.
                f.write(f"xrandr --output {GLib.shell_quote(main)} --primary\n")
        os.chmod(SAVED, 0o755)

    def message(self, text):
        dialog = Gtk.MessageDialog(transient_for=self.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.OK, text=text)
        dialog.run()
        dialog.destroy()


def main():
    GLib.set_prgname(APP_ID)
    app = Gtk.Application(application_id=APP_ID)

    def activate(app):
        if app.get_windows():
            app.get_windows()[0].present()
            return
        Gtk.Settings.get_default().props.gtk_application_prefer_dark_theme = True
        window = Gtk.ApplicationWindow(application=app, title=f"{TITLE} settings")
        window.set_default_size(720, 600)
        window.set_icon_name(ICON)
        scroller = Gtk.ScrolledWindow()
        scroller.add(Page())
        window.add(scroller)
        window.show_all()
    app.connect("activate", activate)
    sys.exit(app.run(sys.argv))


if __name__ == "__main__":
    main()
