#!/usr/bin/env python3
"""SkorneX Mouse settings: pointer speed, acceleration, scrolling, button
swap, double-click speed, pointer size, and touchpad options, like Windows'
Mouse and Touchpad settings.

    skornex-mouse     open it on its own (or search "Mouse settings")

It's also a page in Settings (skornex-settings). Changes apply right away.
They're saved in ~/.config/skornex/labwc/mouse.xml (and mouse.env for the
pointer size), which skornex-labwc adds to labwc's settings.
"""

import json
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

TITLE = "Mouse"
ICON = "input-mouse"
APP_ID = "dev.skornex.Mouse"
DOUBLE_CLICK = getattr(Gdk.EventType, "DOUBLE_BUTTON_PRESS", None) or getattr(Gdk.EventType, "_2BUTTON_PRESS")

STATE = os.path.expanduser("~/.config/skornex/mouse.json")
CHANGES = os.path.expanduser("~/.config/skornex/labwc")
DEFAULTS = {
    "speed": 0.0, "accel": True, "natural": False, "left_handed": False,
    "scroll": 1.0, "double_click": 500, "cursor": 24,
    "tap": True, "touch_natural": True, "dwt": True,
}
CURSOR_SIZES = [(24, "Normal"), (32, "Large"), (48, "Extra large")]


def yes(value):
    return "yes" if value else "no"


def load():
    try:
        with open(STATE) as f:
            return {**DEFAULTS, **json.load(f)}
    except (OSError, ValueError):
        return dict(DEFAULTS)


def save(s):
    os.makedirs(CHANGES, exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(s, f, indent=1)
    with open(os.path.join(CHANGES, "mouse.xml"), "w") as f:
        f.write(f"""<?xml version="1.0"?>
<!-- Made by Mouse settings (skornex-mouse). -->
<labwc_config>
  <mouse>
    <doubleClickTime>{int(s["double_click"])}</doubleClickTime>
  </mouse>
  <libinput>
    <device category="default">
      <pointerSpeed>{s["speed"]:.2f}</pointerSpeed>
      <accelProfile>{"adaptive" if s["accel"] else "flat"}</accelProfile>
      <naturalScroll>{yes(s["natural"])}</naturalScroll>
      <leftHanded>{yes(s["left_handed"])}</leftHanded>
      <scrollFactor>{s["scroll"]:.2f}</scrollFactor>
    </device>
    <device category="touchpad">
      <pointerSpeed>{s["speed"]:.2f}</pointerSpeed>
      <tap>{yes(s["tap"])}</tap>
      <naturalScroll>{yes(s["touch_natural"])}</naturalScroll>
      <disableWhileTyping>{yes(s["dwt"])}</disableWhileTyping>
      <leftHanded>{yes(s["left_handed"])}</leftHanded>
      <scrollFactor>{s["scroll"]:.2f}</scrollFactor>
    </device>
  </libinput>
</labwc_config>
""")
    with open(os.path.join(CHANGES, "mouse.env"), "w") as f:
        f.write(f"# Made by Mouse settings (skornex-mouse).\nXCURSOR_SIZE={int(s['cursor'])}\n")
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", str(int(s["cursor"]))],
                   stderr=subprocess.DEVNULL)
    subprocess.run([os.path.expanduser("~/.local/bin/skornex-labwc")])


class Page(Gtk.Box):
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.set_border_width(24)
        self.s = load()
        self.pending = None
        title = Gtk.Label(xalign=0)
        title.set_markup(f"<span size='x-large' weight='bold'>{TITLE}</span>")
        self.pack_start(title, False, False, 0)

        self.grid = Gtk.Grid(row_spacing=10, column_spacing=24)
        self.pack_start(self.grid, False, False, 0)
        self.row = 0
        self.heading("Mouse")
        self.slider("Pointer speed", "speed", -1, 1, 0.05, "Slow", "Fast")
        self.switch("Mouse acceleration (pointer goes further when you move fast)", "accel")
        self.switch("Swap left and right buttons", "left_handed")
        self.slider("Scroll speed", "scroll", 0.25, 3, 0.25, "Slow", "Fast")
        self.switch("Natural scrolling (content follows your finger)", "natural")
        self.slider("Double-click speed", "double_click", 200, 900, 50, "Fast", "Slow")
        self.combo("Pointer size (after you log out and back in)", "cursor", CURSOR_SIZES)
        self.heading("Touchpad")
        self.switch("Tap to click", "tap")
        self.switch("Natural scrolling", "touch_natural")
        self.switch("Turn off while typing", "dwt")

        test = Gtk.Label(xalign=0)
        test.set_markup("<span alpha='60%'>Changes apply right away. Double-click here to test: </span>")
        box = Gtk.EventBox()
        target = Gtk.Label(label="📁 Double-click me")
        box.add(target)
        box.connect("button-press-event", lambda _w, e: e.type == DOUBLE_CLICK and target.set_text(
            "✔ Opened!" if target.get_text() != "✔ Opened!" else "📁 Double-click me"))
        line = Gtk.Box(spacing=8)
        line.pack_start(test, False, False, 0)
        line.pack_start(box, False, False, 0)
        self.pack_start(line, False, False, 8)
        reset = Gtk.Button(label="Reset to defaults")
        reset.set_halign(Gtk.Align.START)
        reset.connect("clicked", lambda _b: self.reset())
        self.pack_start(reset, False, False, 0)

    def heading(self, text):
        label = Gtk.Label(xalign=0)
        label.set_markup(f"<b>{text}</b>")
        label.set_margin_top(8)
        self.grid.attach(label, 0, self.row, 2, 1)
        self.row += 1

    def add(self, text, widget):
        self.grid.attach(Gtk.Label(label=text, xalign=0), 0, self.row, 1, 1)
        widget.set_hexpand(True)
        self.grid.attach(widget, 1, self.row, 1, 1)
        self.row += 1

    def changed(self, key, value):
        self.s[key] = value
        # Save once the slider stops moving, not on every step.
        if self.pending:
            GLib.source_remove(self.pending)
        self.pending = GLib.timeout_add(300, self.flush)

    def flush(self):
        self.pending = None
        save(self.s)
        return False

    def slider(self, text, key, low, high, step, left, right):
        box = Gtk.Box(spacing=6)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low, high, step)
        scale.set_draw_value(False)
        scale.set_value(self.s[key])
        scale.set_hexpand(True)
        scale.set_size_request(220, -1)
        scale.connect("value-changed", lambda sc: self.changed(key, sc.get_value()))
        box.pack_start(Gtk.Label(label=left), False, False, 0)
        box.pack_start(scale, True, True, 0)
        box.pack_start(Gtk.Label(label=right), False, False, 0)
        self.add(text, box)

    def switch(self, text, key):
        sw = Gtk.Switch(active=self.s[key], halign=Gtk.Align.START)
        sw.connect("notify::active", lambda w, _p: self.changed(key, w.get_active()))
        self.add(text, sw)

    def combo(self, text, key, options):
        combo = Gtk.ComboBoxText()
        for value, name in options:
            combo.append(str(value), name)
        combo.set_active_id(str(self.s[key]))
        combo.connect("changed", lambda c: self.changed(key, int(c.get_active_id())))
        self.add(text, combo)

    def reset(self):
        save(dict(DEFAULTS))
        parent = self.get_parent()
        if isinstance(parent, Gtk.Viewport):  # rebuild the page with the defaults
            parent.remove(self)
            parent.add(Page())
            parent.show_all()


def main():
    GLib.set_prgname(APP_ID)
    app = Gtk.Application(application_id=APP_ID)

    def activate(app):
        if app.get_windows():
            app.get_windows()[0].present()
            return
        Gtk.Settings.get_default().props.gtk_application_prefer_dark_theme = True
        window = Gtk.ApplicationWindow(application=app, title=f"{TITLE} settings")
        window.set_default_size(680, 620)
        window.set_icon_name(ICON)
        scroller = Gtk.ScrolledWindow()
        scroller.add(Page())
        window.add(scroller)
        window.show_all()
    app.connect("activate", activate)
    sys.exit(app.run(sys.argv))


if __name__ == "__main__":
    main()
