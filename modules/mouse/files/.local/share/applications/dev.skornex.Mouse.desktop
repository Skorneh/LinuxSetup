[Desktop Entry]
# SkorneX Settings module (mouse). Named after the window's app ID so the
# taskbar and title bar find its icon.
Type=Application
Name=Mouse settings
Comment=Pointer speed, scrolling, button swap, double-click speed and touchpad.
Exec=skornex-mouse
Icon=input-mouse
StartupWMClass=dev.skornex.Mouse
Categories=Settings;
Keywords=mouse;pointer;cursor;touchpad;scroll;click;
