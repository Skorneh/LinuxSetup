# Runs when labwc starts. Each line starts one background piece.

# The PC boots straight to the lock screen: greetd logs you in and sets
# LOCK_ON_START, so your password is asked here instead of at a login screen.
[ -n "$LOCK_ON_START" ] && hyprlock &

swaybg -c "#$(. ~/.config/skornex/colors; echo "$BG")" >/dev/null 2>&1 &
# SkorneXBar (taskbar) and SkorneXDesktop (Recycle Bin). If either ever
# crashes it starts again a second later, and what went wrong is saved in
# ~/.cache/skornex-bar.log or ~/.cache/skornex-desktop.log.
mkdir -p ~/.cache
keep_running() {
    log=~/.cache/$1.log
    (while kill -0 "$LABWC_PID" 2>/dev/null; do
        echo "--- $(date) starting" >> "$log"
        ~/.local/bin/"$1" >> "$log" 2>&1
        echo "--- stopped (exit code $?)" >> "$log"
        sleep 1
    done) &
}
keep_running skornex-bar
keep_running skornex-desktop
dunst >/dev/null 2>&1 &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1 &
wl-paste --type text --watch cliphist store >/dev/null 2>&1 &
wl-paste --type image --watch cliphist store >/dev/null 2>&1 &

# Lock after 10 minutes idle, monitor off after 15. Videos and games that
# ask the screen to stay on are respected.
swayidle -w \
    timeout 600 'pidof hyprlock || hyprlock &' \
    timeout 900 'wlopm --off \*' resume 'wlopm --on \*' \
    >/dev/null 2>&1 &

# Dark mode for GTK apps (Nemo, Firefox dialogs).
gsettings set org.gnome.desktop.interface color-scheme prefer-dark
gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark
gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark
gsettings set org.gnome.desktop.interface cursor-theme Adwaita

# Notepad (Mousepad): line numbers and a dark color scheme.
gsettings set org.xfce.mousepad.preferences.view show-line-numbers true
gsettings set org.xfce.mousepad.preferences.view color-scheme oblivion
gsettings set org.xfce.mousepad.preferences.view highlight-current-line true
