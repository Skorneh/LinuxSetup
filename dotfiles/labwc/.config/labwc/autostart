# Runs when labwc starts. Each line starts one background piece.

# The PC boots straight to the lock screen: greetd logs you in and sets
# LOCK_ON_START, so your password is asked here instead of at a login screen.
# The lock screen starts first, and everything else waits a moment so the
# desktop doesn't flash on screen before it.
if [ -n "$LOCK_ON_START" ]; then
    hyprlock &
    sleep 2
fi

# Your screen layout (from Display settings) first, so the taskbar and the
# desktop start on the right monitors.
[ -x ~/.config/skornex/autostart.d/display ] && ~/.config/skornex/autostart.d/display >/dev/null 2>&1

# SkorneXBar (taskbar) and SkorneXDesktop (Recycle Bin). If either ever
# crashes it starts again a second later, and what went wrong is saved in
# ~/.cache/skornex-bar.log or ~/.cache/skornex-desktop.log.
mkdir -p ~/.cache
keep_running() {
    log=~/.cache/$1.log
    (while kill -0 "$LABWC_PID" 2>/dev/null; do
        echo "--- $(date) starting" >> "$log"
        ~/.local/bin/"$1" >> "$log" 2>&1
        echo "--- stopped (exit code $?)" >> "$log"
        sleep 1
    done) &
}
keep_running skornex-bar
keep_running skornex-desktop
dunst >/dev/null 2>&1 &


# Settings modules put things to run at login here (Display: your screen
# layout; Updates: the update reminder).
for script in ~/.config/skornex/autostart.d/*; do
    [ "${script##*/}" = display ] && continue  # already done above
    [ -x "$script" ] && "$script" >/dev/null 2>&1 &
done
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1 &

# Lock after 10 minutes idle, screen off after 15 (change them in the Power
# settings module, or in ~/.config/skornex/power).
~/.local/bin/skornex-idle >/dev/null 2>&1 &

# SkorneX's defaults, applied once (skornex-once): after that, whatever you
# change in these stays changed, through restarts and updates.
once=~/.local/bin/skornex-once
# Dark mode for GTK apps (Nemo, Firefox dialogs).
$once gtk-dark gsettings set org.gnome.desktop.interface color-scheme prefer-dark
$once gtk-theme gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark
$once icon-theme gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark
$once cursor-theme gsettings set org.gnome.desktop.interface cursor-theme Adwaita
# Notepad (Mousepad): line numbers and a dark color scheme.
$once notepad-line-numbers gsettings set org.xfce.mousepad.preferences.view show-line-numbers true
$once notepad-colors gsettings set org.xfce.mousepad.preferences.view color-scheme oblivion
$once notepad-current-line gsettings set org.xfce.mousepad.preferences.view highlight-current-line true
# Files (Nemo): scripts use Nemo's normal behavior (it asks whether to run or
# open them). Undoes an earlier SkorneX setting on machines that had it.
$once nemo-scripts gsettings reset org.nemo.preferences executable-text-activation
# Files: Documents, Downloads, Pictures, Music and Videos (the first five
# bookmarks, set up by skornex-folders) under "My Computer" in the sidebar.
$once home-folders ~/.local/bin/skornex-folders >/dev/null 2>&1
$once nemo-sidebar gsettings set org.nemo.window-state sidebar-bookmark-breakpoint 5
