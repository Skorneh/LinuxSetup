<?xml version="1.0"?>
<!--
  SkorneX's labwc settings. Windows float like on Windows; drag one to a
  screen edge or corner to snap it. Colors live in themerc-override, made by
  skornex-theme. All options: man 5 labwc-config. Actions: man 5 labwc-actions.

  labwc reads rc.xml, which skornex-labwc builds from this file plus the
  changes Settings modules save in ~/.config/skornex/labwc/ (mouse.xml,
  keyboard.xml, shortcuts.xml). Edit this file or those, never rc.xml, then
  run `skornex-labwc` in a terminal to rebuild and reload.
-->
<labwc_config>

  <theme>
    <cornerRadius>6</cornerRadius>
    <icon>Papirus-Dark</icon>
    <!-- Windows that have no icon of their own get a plain app icon instead
         of labwc's logo. -->
    <fallbackAppIcon>application-x-executable</fallbackAppIcon>
    <font name="Maple Mono NF" size="10" />
  </theme>

  <!-- Click to focus, like Windows. -->
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <!-- Drag to an edge: half screen. Corner: quarter. Top: maximize. -->
  <snapping>
    <range inner="10" outer="10" />
    <cornerRange>50</cornerRange>
    <topMaximize>yes</topMaximize>
  </snapping>

  <!-- Alt+Tab: every window separately, with a preview. -->
  <windowSwitcher preview="yes" outlines="yes">
    <osd show="yes" style="thumbnail" output="focused" />
  </windowSwitcher>

  <!--
    Mouse: labwc's defaults (drag title bars, double-click to maximize…), but
    clicking the empty desktop does nothing. Side buttons (back/forward) go
    straight to the app, so Firefox and Nemo handle them themselves.
  -->
  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Left" action="Press"><action name="None" /></mousebind>
      <mousebind button="Right" action="Press"><action name="None" /></mousebind>
      <mousebind button="Middle" action="Press"><action name="None" /></mousebind>
    </context>
    <!-- The icon in a window's title bar is just an icon: no window menu
         (minimize/maximize/close are the buttons on the right). -->
    <context name="Icon">
      <mousebind button="Left" action="Click"><action name="None" /></mousebind>
      <mousebind button="Right" action="Click"><action name="None" /></mousebind>
    </context>
    <context name="WindowMenu">
      <mousebind button="Left" action="Click"><action name="None" /></mousebind>
      <mousebind button="Right" action="Click"><action name="None" /></mousebind>
    </context>
    <context name="Title">
      <mousebind button="Right" action="Click"><action name="None" /></mousebind>
    </context>
  </mouse>

  <keyboard>
    <numlock>on</numlock>

    <!-- Windows key alone: the search (apps and files), like the Start menu. -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="~/.local/bin/skornex-bar search" />
    </keybind>
    <!-- Ctrl+Space: the same search, like Spotlight. -->
    <keybind key="C-space">
      <action name="Execute" command="~/.local/bin/skornex-bar search" />
    </keybind>
    <keybind key="W-r">
      <action name="Execute" command="~/.local/bin/skornex-bar run" />
    </keybind>
    <!-- Win+V: clipboard history. -->
    <keybind key="W-v">
      <action name="Execute" command="~/.local/bin/skornex-bar clipboard" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="nemo" />
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="kitty" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="hyprlock" />
    </keybind>

    <!-- SkorneX tools in ~/.local/bin. -->
    <keybind key="C-S-Escape">
      <action name="Execute" command="~/.local/bin/skornex-taskmgr" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Execute" command="~/.local/bin/skornex-bar power" />
    </keybind>

    <!-- Screenshots, straight to the clipboard. Win+Print saves a file. -->
    <keybind key="Print">
      <action name="Execute" command="~/.local/bin/skornex-screenshot region" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="~/.local/bin/skornex-screenshot full" />
    </keybind>
    <keybind key="W-Print">
      <action name="Execute" command="~/.local/bin/skornex-screenshot save" />
    </keybind>

    <!-- Windows. -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <!-- Force-quit the window you're in, for when it's frozen. -->
    <keybind key="C-A-q">
      <action name="Kill" />
    </keybind>
    <keybind key="W-Up">
      <action name="Maximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" combine="yes" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" combine="yes" />
    </keybind>
    <keybind key="W-S-Left">
      <action name="MoveToOutput" direction="left" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="MoveToOutput" direction="right" />
    </keybind>
    <!-- Stretch to the full screen height, and back. -->
    <keybind key="W-S-Up">
      <action name="Maximize" direction="vertical" />
    </keybind>
    <keybind key="W-S-Down">
      <action name="UnMaximize" />
    </keybind>
    <keybind key="W-d">
      <action name="ToggleShowDesktop" />
    </keybind>

    <!-- Volume keys. -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="~/.local/bin/skornex-volume up" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="~/.local/bin/skornex-volume down" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="~/.local/bin/skornex-volume mute" />
    </keybind>
  </keyboard>

  <!-- Mouse acceleration off: the pointer moves the same distance however fast
       you move the mouse. Touchpads keep it, they feel wrong without it. -->
  <libinput>
    <device category="default">
      <accelProfile>flat</accelProfile>
    </device>
    <device category="touchpad">
      <accelProfile>adaptive</accelProfile>
    </device>
  </libinput>
</labwc_config>
