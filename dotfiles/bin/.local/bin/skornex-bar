ICON_ETHERNET = "\U000f0200"
ICON_WIFI = "\U000f05a9"
ICON_OFFLINE = "\U000f0318"
ICON_VOLUME = ["\U000f057f", "\U000f0580", "\U000f057e"]  # low, medium, high (same icon set as muted)
ICON_MUTED = "\U000f0581"
ICON_POWER = ""

# Wi-Fi signal: 1 to 4 bars, and a padlock for networks with a password.
ICON_WIFI_BARS = ["\U000f091f", "\U000f0922", "\U000f0925", "\U000f0928"]
ICON_LOCK = "\uf023"

# Battery (laptops only): 10% steps, and the same while charging.
ICON_BATTERY = ["\U000f007a", "\U000f007b", "\U000f007c", "\U000f007d", "\U000f007e",
                "\U000f007f", "\U000f0080", "\U000f0081", "\U000f0082", "\U000f0079"]
ICON_CHARGING = ["\U000f089c", "\U000f0086", "\U000f0087", "\U000f0088", "\U000f089d",
                 "\U000f0089", "\U000f089e", "\U000f008a", "\U000f008b", "\U000f0085"]


def find_battery():
    """The laptop's battery in /sys, or None on a desktop PC."""
    for path in sorted(glob.glob("/sys/class/power_supply/*")):
        try:
            with open(os.path.join(path, "type")) as f:
                if f.read().strip() == "Battery" and os.path.exists(os.path.join(path, "capacity")):
                    return path
        except OSError:
            pass
    return None


def read_sys(path, name):
    try:
        with open(os.path.join(path, name)) as f:
            return f.read().strip()
    except OSError:
        return ""


# Clipboard history: how many items Win+V shows, and the apps that paste with
# Ctrl+Shift+V instead of Ctrl+V.
CLIP_ITEMS = 25
TERMINALS = {"kitty", "foot", "alacritty", "org.wezfurlong.wezterm", "xterm", "org.gnome.console"}

DOUBLE_CLICK = getattr(Gdk.EventType, "DOUBLE_BUTTON_PRESS", None) or getattr(Gdk.EventType, "_2BUTTON_PRESS")


# --- Small helpers ----------------------------------------------------------

def run(*cmd):
    """Run a command, return its output ('' if it fails)."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def run_async(cmd, done=None):
    """Run a command without freezing the bar; done(ok, output) gets called after."""
    def finish(proc, result):
        try:
            _ok, out, _err = proc.communicate_utf8_finish(result)
            ok = proc.get_successful()
        except GLib.Error:
            ok, out = False, ""
        if done:
            done(ok, out or "")
    try:
        proc = Gio.Subprocess.new(cmd, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
    except GLib.Error:
        if done:
            done(False, "")
        return
    proc.communicate_utf8_async(None, None, finish)


def nmcli_fields(line):
    """Split one line of `nmcli -t` output; it escapes ':' inside values as '\\:'."""
    return [f.replace("\\:", ":").replace("\\\\", "\\") for f in re.split(r"(?<!\\):", line)]


def find_path(path):
    """An absolute path as typed, or with different capitals if that's the
    only way it exists (~/downloads finds ~/Downloads). None if neither."""
    if not path.startswith("/"):
        return None
    if os.path.exists(path):
        return path
    found = "/"
    for part in [p for p in path.split("/") if p]:
        exact = os.path.join(found, part)
        if os.path.exists(exact):
            found = exact
            continue
        try:
            match = next((n for n in os.listdir(found) if n.casefold() == part.casefold()), None)
        except OSError:
            return None
        if match is None:
            return None
        found = os.path.join(found, match)
    return found


def spawn(*cmd):
    """Start a program on its own, without waiting for it."""
    try:
        subprocess.Popen(cmd, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def after_menu(callback):
    """Run a right-click menu choice once the menu has fully closed. Acting
    while it's still closing (say, a new window popping up) can make Wayland
    reject the menu and shut the whole bar down."""
    GLib.timeout_add(150, lambda: callback() and False)


def label(text, *classes):
    widget = Gtk.Label(label=text)
    for c in classes:
        widget.get_style_context().add_class(c)
    return widget


# The main display (from Display settings): the output's name, like DP-1.
MAIN_DISPLAY_FILE = os.path.join(CONFIG, "main-display")
_main_monitor = []


def main_monitor():
    """The monitor for the taskbar, its pop-ups and the desktop icons: the main
    display picked in Display settings, else the first one."""
    if _main_monitor:
        return _main_monitor[0]
    display = Gdk.Display.get_default()
    monitors = [display.get_monitor(i) for i in range(display.get_n_monitors())]
    chosen = None
    try:
        with open(MAIN_DISPLAY_FILE) as f:
            name = f.read().strip()
    except OSError:
        name = ""
    if name:
        # GTK doesn't know output names; match by position instead.
        try:
            outputs = json.loads(run("wlr-randr", "--json") or "[]")
        except ValueError:
            outputs = []
        pos = next(((o["position"]["x"], o["position"]["y"]) for o in outputs
                    if o.get("name") == name and o.get("enabled")), None)
        chosen = next((m for m in monitors if pos and
                       (m.get_geometry().x, m.get_geometry().y) == pos), None)
    chosen = chosen or display.get_primary_monitor() or (monitors[0] if monitors else None)
    _main_monitor.append(chosen)
    return chosen


def make_layer(window, layer, anchors, keyboard=GtkLayerShell.KeyboardMode.NONE, namespace="skornex",
               monitor=None):
    GtkLayerShell.init_for_window(window)
    monitor = monitor or main_monitor()
    if monitor:
        GtkLayerShell.set_monitor(window, monitor)
    GtkLayerShell.set_namespace(window, namespace)
    GtkLayerShell.set_layer(window, layer)
    for edge in anchors:
        GtkLayerShell.set_anchor(window, edge, True)
    GtkLayerShell.set_keyboard_mode(window, keyboard)


def make_transparent(window):
    visual = window.get_screen().get_rgba_visual()
    if visual:
        window.set_visual(visual)
    window.set_app_paintable(True)


# --- Apps and pins ----------------------------------------------------------

class Apps:
    """Installed apps (.desktop files), and matching windows to them."""

    def __init__(self, on_change=None):
        self.on_change = on_change
        self.reload()
        self.monitor = Gio.AppInfoMonitor.get()
        self.monitor.connect("changed", lambda *_: self.reload())

    def reload(self):
        self.by_id = {}
        self.by_wmclass = {}
        for info in Gio.AppInfo.get_all():
            if not isinstance(info, Gio.DesktopAppInfo):
                continue
            app_id = info.get_id()[:-len(".desktop")]
            self.by_id[app_id] = info
            wm = info.get_startup_wm_class()
            if wm:
                self.by_wmclass[wm.lower()] = app_id
        if self.on_change:
            self.on_change()    # newly installed apps get their icon on the taskbar

    def visible(self):
        return sorted((i for i in self.by_id.items() if i[1].should_show()),
                      key=lambda i: i[1].get_display_name().casefold())

    def find(self, names):
        """The app ID for a window, given the names it reports."""
        lower = {k.lower(): k for k in self.by_id}
        for name in names:
            if not name:
                continue
            n = name.lower()
            for candidate in (name, n, n.split(".")[-1]):
                if candidate in self.by_id:
                    return candidate
                if candidate in lower:
                    return lower[candidate]
                if candidate in self.by_wmclass:
                    return self.by_wmclass[candidate]
        return None

    def launch(self, app_id):
        # gtk-launch starts the app as its own program, not a child of the
        # bar, so apps and the bar can't take each other down.
        if app_id in self.by_id:
            spawn("gtk-launch", app_id)


def read_pins():
    try:
        with open(PINS_FILE) as f:
            return [ln.strip() for ln in f if ln.strip() and not ln.startswith("#")]
    except OSError:
        return ["nemo"]


def write_pins(pins):
    os.makedirs(CONFIG, exist_ok=True)
    if os.path.islink(PINS_FILE):  # older SkorneX linked it into the repo; make it yours
        os.unlink(PINS_FILE)
    with open(PINS_FILE, "w") as f:
        f.write("# Apps pinned to the taskbar, left to right. One app ID per line\n"
                "# (the .desktop file name). Right-click a taskbar button to pin or unpin.\n")
        f.writelines(p + "\n" for p in pins)


# --- Taskbar app buttons ----------------------------------------------------

class AppButton(Gtk.Button):
    """One app on the taskbar: pinned, open, or both."""

    def __init__(self, bar, key, info):
        super().__init__()
        self.bar, self.key, self.info = bar, key, info
        self.windows = []
        self.set_relief(Gtk.ReliefStyle.NONE)
        self.set_can_focus(False)
        self.get_style_context().add_class("app")
        self.image = Gtk.Image()
        self.add(self.image)
        self.set_icon()
        self.add_events(Gdk.EventMask.BUTTON_MOTION_MASK)
        self.connect("button-press-event", self.on_press)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("button-release-event", self.on_release)
        self.press_x = None
        self.dragging = False

    def set_icon(self):
        icon = self.info.get_icon() if self.info else None
        if icon:
            self.image.set_from_gicon(icon, Gtk.IconSize.LARGE_TOOLBAR)
            self.image.set_pixel_size(ICON_SIZE)
        elif self.windows:
            pixbuf = self.windows[0].get_icon(ICON_SIZE, self.get_scale_factor())
            if pixbuf:
                self.image.set_from_pixbuf(pixbuf)

    def update_look(self):
        ctx = self.get_style_context()
        self.windows = [w for w in self.windows if w not in self.bar.closed]
        running = bool(self.windows)
        active = any(w.is_active() for w in self.windows)
        for cls, on in (("open", running), ("active", active), ("closed", not running)):
            (ctx.add_class if on else ctx.remove_class)(cls)

    def log_click(self, action):
        """One line per taskbar click in ~/.cache/skornex-bar.log, to track
        down clicks that don't do the right thing."""
        states = ", ".join(
            f"'{(w.get_name() or '?')[:30]}'"
            f"{' active' if w.is_active() else ''}{' minimized' if w.is_minimized() else ''}"
            for w in self.windows)
        print(f"{time.strftime('%H:%M:%S')} click {self.key}: [{states}] -> {action}",
              file=sys.stderr, flush=True)

    # Clicking, like Windows.
    def click(self):
        if not self.windows:
            self.log_click("launch")
            self.bar.apps.launch(self.key)
            return
        recent = sorted(self.windows, key=lambda w: self.bar.last_active.get(w, 0))
        active = [w for w in recent if w.is_active()]
        if active:
            # The app you're using: minimize it (all its windows, since some
            # apps, like Files, keep an extra hidden one).
            self.log_click("minimize")
            for w in recent:
                self.try_(w.set_minimized, True)
        else:
            minimized = [w for w in recent if w.is_minimized()]
            window = (minimized or recent)[-1]     # bring back the one you minimized
            self.log_click(f"show '{(window.get_name() or '?')[:30]}'")
            if window.is_minimized():
                self.try_(window.set_minimized, False)
            self.try_(window.activate, self.bar.seat(), 0)

    @staticmethod
    def try_(fn, *args):
        try:
            fn(*args)
        except (GLib.Error, TypeError, ValueError) as e:
            print(f"skornex-bar: {getattr(fn, '__name__', fn)} failed: {e}", file=sys.stderr, flush=True)

    def menu(self, event):
        menu = Gtk.Menu()
        name = self.info.get_display_name() if self.info else (self.windows[0].get_name() if self.windows else "")

        def item(text, callback):
            mi = Gtk.MenuItem(label=text)
            mi.connect("activate", lambda *_: after_menu(callback))
            menu.append(mi)

        if self.info:
            item(name if not self.windows else f"New {name} window", lambda: self.bar.apps.launch(self.key))
            if self.key in self.bar.pins:
                item("Unpin from taskbar", lambda: self.bar.unpin(self.key))
            else:
                item("Pin to taskbar", lambda: self.bar.pin(self.key))
            item("Add to desktop", lambda: add_to_desktop(self.info))
        if self.windows:
            menu.append(Gtk.SeparatorMenuItem())
            text = "Close window" if len(self.windows) == 1 else "Close all windows"
            item(text, lambda: [self.try_(w.close, 0) for w in list(self.windows)])
        menu.show_all()
        menu.attach_to_widget(self, None)
        menu.set_property("rect-anchor-dy", -8)      # a little gap above the bar, like the panels
        menu.popup_at_widget(self, Gdk.Gravity.NORTH, Gdk.Gravity.SOUTH, event)

    # Drag to reorder; the button follows the mouse.
    def on_press(self, _w, event):
        if event.button == 3:
            self.menu(event)
            return True
        if event.button == 1:
            self.press_x = event.x
            self.dragging = False
        return False

    def on_motion(self, _w, event):
        if self.press_x is None:
            return False
        if not self.dragging and abs(event.x - self.press_x) > 8:
            self.dragging = True
            self.get_style_context().add_class("dragging")
        if self.dragging:
            box = self.get_parent()
            x, _ = self.translate_coordinates(box, int(event.x), int(event.y))
            others = [c for c in box.get_children() if c is not self]
            index = sum(1 for c in others if c.get_allocation().x + c.get_allocation().width / 2 < x)
            box.reorder_child(self, index)
        return True

    def on_release(self, _w, event):
        if event.button == 2:
            self.bar.apps.launch(self.key)
        elif event.button == 1 and self.press_x is not None:
            if self.dragging:
                self.get_style_context().remove_class("dragging")
                self.bar.reordered()
            else:
                self.click()
        self.press_x = None
        self.dragging = False
        return False


# --- Tray (hidden icons): StatusNotifierItem host and watcher ---------------

WATCHER_XML = """
<node><interface name="org.kde.StatusNotifierWatcher">
  <method name="RegisterStatusNotifierItem"><arg type="s" direction="in"/></method>
  <method name="RegisterStatusNotifierHost"><arg type="s" direction="in"/></method>
  <property name="RegisteredStatusNotifierItems" type="as" access="read"/>
  <property name="IsStatusNotifierHostRegistered" type="b" access="read"/>
  <property name="ProtocolVersion" type="i" access="read"/>
  <signal name="StatusNotifierItemRegistered"><arg type="s"/></signal>
  <signal name="StatusNotifierItemUnregistered"><arg type="s"/></signal>
  <signal name="StatusNotifierHostRegistered"/>
</interface></node>"""


class Tray:
    """Collects tray icons from apps like Discord and Steam."""

    def __init__(self, on_change):
        self.on_change = on_change
        self.items = {}   # "busname/path" -> properties dict
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.node = Gio.DBusNodeInfo.new_for_xml(WATCHER_XML)
        for name in ("org.kde.StatusNotifierWatcher", "org.freedesktop.StatusNotifierWatcher"):
            Gio.bus_own_name_on_connection(self.bus, name, Gio.BusNameOwnerFlags.NONE, None, None)
        self.bus.register_object("/StatusNotifierWatcher", self.node.interfaces[0],
                                 self.on_call, self.on_get_property, None)

    def on_call(self, _conn, sender, _path, _iface, method, params, invocation):
        if method == "RegisterStatusNotifierItem":
            service = params.unpack()[0]
            bus_name, path = (sender, service) if service.startswith("/") else (service, "/StatusNotifierItem")
            self.add(bus_name, path)
        invocation.return_value(None)

    def on_get_property(self, _conn, _sender, _path, _iface, prop):
        if prop == "RegisteredStatusNotifierItems":
            return GLib.Variant("as", list(self.items))
        if prop == "IsStatusNotifierHostRegistered":
            return GLib.Variant("b", True)
        if prop == "ProtocolVersion":
            return GLib.Variant("i", 0)
        return None

    def add(self, bus_name, path):
        key = f"{bus_name}{path}"
        if key in self.items:
            return
        self.items[key] = {"bus": bus_name, "path": path}
        self.bus.emit_signal(None, "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher",
                             "StatusNotifierItemRegistered", GLib.Variant("(s)", (key,)))
        Gio.bus_watch_name_on_connection(self.bus, bus_name, Gio.BusNameWatcherFlags.NONE,
                                         None, lambda *_: self.remove(key))
        for iface in ("org.kde.StatusNotifierItem", "org.freedesktop.StatusNotifierItem"):
            self.bus.signal_subscribe(bus_name, iface, None, path, None,
                                      Gio.DBusSignalFlags.NONE, lambda *_: self.refresh(key))
        self.refresh(key)

    def remove(self, key):
        if self.items.pop(key, None) is not None:
            self.on_change()

    def refresh(self, key):
        item = self.items.get(key)
        if not item:
            return
        for iface in ("org.kde.StatusNotifierItem", "org.freedesktop.StatusNotifierItem"):
            try:
                result = self.bus.call_sync(item["bus"], item["path"], "org.freedesktop.DBus.Properties",
                                            "GetAll", GLib.Variant("(s)", (iface,)), None,
                                            Gio.DBusCallFlags.NONE, 2000, None)
            except GLib.Error:
                continue
            props = result.unpack()[0]
            if props:
                item.update(props, iface=iface)
                break
        self.on_change()

    def icon_widget(self, item):
        image = Gtk.Image()
        theme_path = item.get("IconThemePath")
        if theme_path:
            Gtk.IconTheme.get_default().append_search_path(theme_path)
        name = item.get("IconName")
        if name and Gtk.IconTheme.get_default().has_icon(name):
            image.set_from_icon_name(name, Gtk.IconSize.LARGE_TOOLBAR)
            image.set_pixel_size(ICON_SIZE)
            return image
        pixbuf = self.pixmap(item.get("IconPixmap"))
        if pixbuf:
            image.set_from_pixbuf(pixbuf)
        else:
            image.set_from_icon_name("application-x-executable", Gtk.IconSize.LARGE_TOOLBAR)
        return image

    @staticmethod
    def pixmap(pixmaps):
        """Turn a tray icon's raw ARGB image into something GTK can show."""
        if not pixmaps:
            return None
        w, h, data = max(pixmaps, key=lambda p: p[0] * p[1])
        data = bytes(data)
        if not w or not h or len(data) < w * h * 4:
            return None
        rgba = bytearray(len(data))
        rgba[0::4], rgba[1::4], rgba[2::4], rgba[3::4] = data[1::4], data[2::4], data[3::4], data[0::4]
        pixbuf = GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(rgba)), GdkPixbuf.Colorspace.RGB,
                                                 True, 8, w, h, w * 4)
        return pixbuf.scale_simple(ICON_SIZE, ICON_SIZE, GdkPixbuf.InterpType.BILINEAR)

    def activate(self, item):
        self.call(item, "Activate", GLib.Variant("(ii)", (0, 0)))

    def context_menu(self, item, widget, event, done):
        """The app's own right-click menu (Discord: Mute, Deafen, Quit…), drawn
        like the taskbar's menus. Apps without one get Open and Quit."""
        menu = Gtk.Menu()
        layout = self.menu_layout(item)
        if layout:
            self.fill_menu(menu, item, layout, done)
        if not menu.get_children():
            title = item.get("Title") or "app"
            for text, cb in [(f"Open {title}", lambda: self.activate(item)),
                             (f"Quit {title}", lambda: self.quit(item))]:
                mi = Gtk.MenuItem(label=text)
                mi.connect("activate", lambda _m, cb=cb: (cb(), done()))
                menu.append(mi)
        menu.show_all()
        menu.attach_to_widget(widget, None)
        menu.set_property("rect-anchor-dy", -8)
        menu.popup_at_widget(widget, Gdk.Gravity.NORTH, Gdk.Gravity.SOUTH, event)

    def menu_layout(self, item):
        path = item.get("Menu")
        if not path:
            return None
        try:
            self.bus.call_sync(item["bus"], path, "com.canonical.dbusmenu", "AboutToShow",
                               GLib.Variant("(i)", (0,)), None, Gio.DBusCallFlags.NONE, 1000, None)
        except GLib.Error:
            pass  # optional for apps
        try:
            result = self.bus.call_sync(item["bus"], path, "com.canonical.dbusmenu", "GetLayout",
                                        GLib.Variant("(iias)", (0, -1, [])), None,
                                        Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error as e:
            print(f"skornex-bar: tray menu failed: {e}", file=sys.stderr, flush=True)
            return None
        return result.unpack()[1]   # (id, properties, children)

    def fill_menu(self, menu, item, layout, done):
        for _id, props, children in layout[2]:
            if not props.get("visible", True):
                continue
            if props.get("type") == "separator":
                menu.append(Gtk.SeparatorMenuItem())
                continue
            text = props.get("label", "")
            if props.get("toggle-type") in ("checkmark", "radio"):
                mi = Gtk.CheckMenuItem.new_with_mnemonic(text)
                mi.set_draw_as_radio(props["toggle-type"] == "radio")
                mi.set_active(props.get("toggle-state", 0) == 1)
            else:
                mi = Gtk.MenuItem.new_with_mnemonic(text)
            mi.set_sensitive(props.get("enabled", True))
            if children:
                sub = Gtk.Menu()
                self.fill_menu(sub, item, (_id, props, children), done)
                mi.set_submenu(sub)
            else:
                mi.connect("activate", lambda _m, i=_id: (self.menu_click(item, i), done()))
            menu.append(mi)

    def menu_click(self, item, item_id):
        self.bus.call(item["bus"], item["Menu"], "com.canonical.dbusmenu", "Event",
                      GLib.Variant("(isvu)", (item_id, "clicked", GLib.Variant("i", 0), 0)),
                      None, Gio.DBusCallFlags.NONE, 2000, None, None, None)

    def quit(self, item):
        try:
            pid = self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                                     "GetConnectionUnixProcessID", GLib.Variant("(s)", (item["bus"],)),
                                     None, Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
            os.kill(pid, signal.SIGTERM)
        except (GLib.Error, OSError) as e:
            print(f"skornex-bar: quit failed: {e}", file=sys.stderr, flush=True)

    def call(self, item, method, params):
        self.bus.call(item["bus"], item["path"], item.get("iface", "org.kde.StatusNotifierItem"),
                      method, params, None, Gio.DBusCallFlags.NONE, 2000, None, None)


# --- Pop-up panels ("flyouts") ----------------------------------------------

class Flyout(Gtk.Window):
    """A small panel above the taskbar. Closes when you click anywhere else."""

    def __init__(self, side="right", keyboard=False):
        super().__init__()
        self.side = side
        edge = GtkLayerShell.Edge.RIGHT if side == "right" else GtkLayerShell.Edge.LEFT
        mode = GtkLayerShell.KeyboardMode.EXCLUSIVE if keyboard else GtkLayerShell.KeyboardMode.ON_DEMAND
        make_layer(self, GtkLayerShell.Layer.OVERLAY, [GtkLayerShell.Edge.BOTTOM, edge], mode, "skornex-flyout")
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, 8)
        GtkLayerShell.set_margin(self, edge, 8)
        self.get_style_context().add_class("flyout")
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.box.get_style_context().add_class("flyout-box")
        self.add(self.box)

    def set_left(self, x):
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, max(8, x))

    def clear(self):
        for child in self.box.get_children():
            self.box.remove(child)


class VolumeOsd(Gtk.Window):
    """The small volume bar that pops up above the sound icon when you press
    the volume keys, then fades away."""

    def __init__(self):
        super().__init__()
        make_layer(self, GtkLayerShell.Layer.OVERLAY, [GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.RIGHT],
                   namespace="skornex-osd")
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, 8)
        self.get_style_context().add_class("flyout")
        self.get_style_context().add_class("osd")
        box = Gtk.Box(spacing=10)
        box.get_style_context().add_class("flyout-box")
        self.icon = label("")
        self.bar = Gtk.ProgressBar()
        self.bar.set_valign(Gtk.Align.CENTER)
        self.bar.set_size_request(150, -1)
        self.percent = label("", "status")
        self.percent.set_width_chars(4)
        box.pack_start(self.icon, False, False, 0)
        box.pack_start(self.bar, True, True, 0)
        box.pack_start(self.percent, False, False, 0)
        self.add(box)
        self.timer = None

    def show_level(self, level, muted, right):
        self.icon.set_text(ICON_MUTED if muted else ICON_VOLUME[min(2, level // 34)])
        self.bar.set_fraction(0 if muted else level / 100)
        self.percent.set_text(f"{level}%")  # same width muted or not; the icon shows muted
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, max(8, right))
        self.show_all()
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(1500, self.fade)

    def fade(self):
        self.timer = None
        self.hide()
        return False


class Catcher(Gtk.Window):
    """An invisible layer over everything but the taskbar while a flyout is
    open. Clicking it closes the flyout, like clicking away on Windows."""

    def __init__(self, on_click):
        super().__init__()
        make_layer(self, GtkLayerShell.Layer.TOP,
                   [GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                    GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT],
                   namespace="skornex-catcher")
        make_transparent(self)
        self.get_style_context().add_class("catcher")
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", lambda *_: on_click())


# --- The bar ----------------------------------------------------------------

class Bar(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app)
        self.app = app
        make_layer(self, GtkLayerShell.Layer.TOP,
                   [GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT],
                   namespace="skornex-bar")
        GtkLayerShell.auto_exclusive_zone_enable(self)
        self.set_size_request(-1, BAR_HEIGHT)
        self.get_style_context().add_class("bar")

        self.apps = Apps(lambda: self.schedule_sync() if hasattr(self, "sync_pending") else None)
        self.pins = read_pins()
        self.order = list(self.pins)   # every taskbar button, left to right
        self.buttons = {}
        self.last_active = {}
        self.open_flyout = None
        self.catcher = Catcher(self.close_flyout)

        row = Gtk.Box(spacing=2)
        self.add(row)

        # Left: search box, then app buttons.
        self.search_button = Gtk.Button()
        self.search_button.get_style_context().add_class("search")
        self.search_button.set_can_focus(False)
        search_row = Gtk.Box(spacing=8)
        search_row.pack_start(label(ICON_SEARCH, "search-icon"), False, False, 0)
        search_row.pack_start(label("Search", "search-text"), False, False, 0)
        self.search_button.add(search_row)
        self.search_button.connect("clicked", lambda *_: self.toggle("search"))
        row.pack_start(self.search_button, False, False, 0)

        self.taskbar = Gtk.Box(spacing=2)
        row.pack_start(self.taskbar, False, False, 0)

        # Right: hidden icons, network, volume, clock, power.
        right = Gtk.Box(spacing=0)
        row.pack_end(right, False, False, 0)
        self.tray_button = self.bar_button(ICON_UP, "tray")
        self.net_button = self.bar_button(ICON_OFFLINE, "network")
        self.vol_button = self.bar_button("", "volume")
        self.clock_button = self.bar_button("", "clock")
        self.power_button = self.bar_button(ICON_POWER, "power")
        # Battery, right after the hidden icons, only on a laptop.
        self.battery = find_battery()
        self.battery_button = self.bar_button("", "battery") if self.battery else None
        self.flyout_buttons = {"tray": self.tray_button, "battery": self.battery_button,
                               "network": self.net_button, "volume": self.vol_button,
                               "clock": self.clock_button, "power": self.power_button}
        for b in self.flyout_buttons.values():
            if b:
                right.pack_start(b, False, False, 0)
        self.vol_button.add_events(Gdk.EventMask.SCROLL_MASK)
        self.vol_button.connect("scroll-event", self.on_volume_scroll)

        self.flyouts = {
            "search": Flyout("left", keyboard=True),
            "tray": Flyout("left"),
            "network": Flyout(),
            "volume": Flyout(),
            "clock": Flyout(),
            "power": Flyout(),
            "run": Flyout("left", keyboard=True),
            "clipboard": Flyout(keyboard=True),
            "battery": Flyout(),
        }
        for fly in self.flyouts.values():
            fly.connect("key-press-event", self.on_flyout_key)

        # Windows.
        self.screen = Xfw.Screen.get_default()
        self.closed = set()
        self.sync_pending = False
        self.screen.connect("window-opened", lambda _s, w: self.watch_window(w))
        self.screen.connect("window-closed", lambda _s, w: self.on_window_closed(w))
        self.screen.connect("active-window-changed", self.on_active_changed)
        for w in self.screen.get_windows():
            self.watch_window(w)

        self.tray = Tray(self.on_tray_change)
        self.files_cache = (0, [])

        self.tick()
        GLib.timeout_add_seconds(1, self.tick)
        self.start_clipboard_history()
        self.sync()
        self.show_all()

    def bar_button(self, text, name):
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_can_focus(False)
        button.get_style_context().add_class("bar-button")
        button.get_style_context().add_class(name)
        button.text = Gtk.Label(label=text)
        button.add(button.text)
        button.connect("clicked", lambda *_: self.toggle(name))
        return button

    # --- Window tracking and app buttons ---

    # Window changes are handled a moment later, never in the middle of the
    # window library's own update; a closed window is never touched again.
    def seat(self):
        """Your keyboard and mouse, which the window library needs to bring a
        window to the front (it won't take "none")."""
        seats = self.screen.get_seats()
        return seats[0] if seats else None

    def raise_app(self, app_id, hint=""):
        """Brings an app's window to the front (skornex-open uses this): the
        window whose title mentions `hint` (a file name), else the one used last."""
        wins = [w for w in self.screen.get_windows() if w not in self.closed
                and app_id.lower() in [n.lower() for n in (w.get_class_ids() or [])]]
        if not wins:
            print(f"skornex-bar: raise: no window for {app_id}", file=sys.stderr, flush=True)
            return False
        named = [w for w in wins if hint and hint in (w.get_name() or "")]
        window = (named or sorted(wins, key=lambda w: self.last_active.get(w, 0)))[-1]
        print(f"skornex-bar: raise: {app_id} '{window.get_name()}'", file=sys.stderr, flush=True)
        if window.is_minimized():
            AppButton.try_(window.set_minimized, False)
        AppButton.try_(window.activate, self.seat(), 0)
        return False

    def watch_window(self, window):
        for sig in ("state-changed", "class-changed", "name-changed", "icon-changed"):
            window.connect(sig, lambda *_: self.schedule_sync())
        window.connect("closed", self.on_window_closed)
        self.schedule_sync()

    def on_window_closed(self, window, *_):
        self.closed.add(window)
        self.last_active.pop(window, None)
        self.schedule_sync()

    def schedule_sync(self, *_):
        if not self.sync_pending:
            self.sync_pending = True
            GLib.idle_add(self.sync)

    def on_active_changed(self, screen, _previous):
        active = screen.get_active_window()
        if active and active not in self.closed:
            self.last_active[active] = time.monotonic()
        self.schedule_sync()

    def group_key(self, window):
        names = list(window.get_class_ids() or [])
        application = window.get_application()
        if application:
            names.append(application.get_class_id())
        app_id = self.apps.find(names)
        return app_id or "window:" + (names[0] if names else window.get_name() or "?")

    def sync(self, *_):
        self.sync_pending = False
        groups = {}
        for w in self.screen.get_windows():
            if w in self.closed or w.is_skip_tasklist():
                continue
            groups.setdefault(self.group_key(w), []).append(w)
        # One row for pinned and open apps, in whatever order you dragged them.
        for key in self.pins + list(groups):
            if key not in self.order:
                self.order.append(key)
        self.order = [k for k in self.order if k in groups or (k in self.pins and k in self.apps.by_id)]
        wanted = self.order

        for key in list(self.buttons):
            if key not in wanted:
                self.taskbar.remove(self.buttons.pop(key))
        for index, key in enumerate(wanted):
            button = self.buttons.get(key)
            if button is None:
                button = AppButton(self, key, self.apps.by_id.get(key))
                self.buttons[key] = button
                self.taskbar.pack_start(button, False, False, 0)
                button.show_all()
            button.windows = groups.get(key, [])
            if not button.info:
                button.set_icon()
            button.update_look()
            if not button.dragging:
                self.taskbar.reorder_child(button, index)
        return False

    def pin(self, key):
        if key not in self.pins:
            self.pins.append(key)
            write_pins(self.pins)
        self.sync()

    def unpin(self, key):
        if key in self.pins:
            self.pins.remove(key)
            write_pins(self.pins)
        self.sync()

    def reordered(self):
        self.order = [b.key for b in self.taskbar.get_children()]
        new_pins = [k for k in self.order if k in self.pins] + [p for p in self.pins if p not in self.order]
        if new_pins != self.pins:
            self.pins = new_pins   # pinned apps remember their order
            write_pins(self.pins)
        self.sync()

    # --- Status on the right (clock, volume, network), every second ---

    def tick(self):
        self.clock_button.text.set_text(time.strftime("%-I:%M %p"))
        now = time.monotonic()
        if now - getattr(self, "_slow_tick", 0) >= 3:
            self._slow_tick = now
            self.update_volume()
            self.update_network()
            self.update_battery()
        return True

    def battery_state(self):
        """(percent, status, hours left or None). Status: Charging, Discharging, Full..."""
        level = int(read_sys(self.battery, "capacity") or 0)
        status = read_sys(self.battery, "status")
        now = read_sys(self.battery, "energy_now") or read_sys(self.battery, "charge_now")
        full = read_sys(self.battery, "energy_full") or read_sys(self.battery, "charge_full")
        rate = read_sys(self.battery, "power_now") or read_sys(self.battery, "current_now")
        hours = None
        try:
            now, full, rate = int(now), int(full), int(rate)
            if rate > 0:
                hours = (full - now) / rate if status == "Charging" else now / rate if status == "Discharging" else None
        except ValueError:
            pass
        return level, status, hours

    def update_battery(self):
        if not self.battery_button:
            return
        level, status, _ = self.battery_state()
        icons = ICON_CHARGING if status in ("Charging", "Full") else ICON_BATTERY
        self.battery_button.text.set_width_chars(5)
        self.battery_button.text.set_text(f"{icons[min(9, max(0, (level - 1) // 10))]} {level}%")

    def fill_battery(self, fly):
        fly.set_size_request(260, -1)
        level, status, hours = self.battery_state()
        fly.box.pack_start(label(f"Battery {level}%", "title"), False, False, 0)
        text = {"Charging": "Charging", "Discharging": "On battery", "Full": "Fully charged",
                "Not charging": "Plugged in, not charging"}.get(status, status)
        if hours is not None and hours < 48:
            h, m = int(hours), int(hours * 60) % 60
            text += f" · {h} h {m:02d} min " + ("until full" if status == "Charging" else "left")
        info = label(text, "status")
        info.set_xalign(0)
        fly.box.pack_start(info, False, False, 0)
        bar = Gtk.ProgressBar()
        bar.set_fraction(level / 100)
        fly.box.pack_start(bar, False, False, 0)

    def volume(self):
        out = run("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")   # "Volume: 0.45 [MUTED]"
        try:
            return round(float(out.split()[1]) * 100), "MUTED" in out
        except (IndexError, ValueError):
            return None, False

    def update_volume(self):
        level, muted = self.volume()
        if level is None:
            self.vol_button.text.set_text(ICON_MUTED)
            return
        icon = ICON_MUTED if muted else ICON_VOLUME[min(2, level // 34)]
        # Always icon + percent, in a fixed width, so muting or going from
        # 5% to 100% never changes the size of the taskbar.
        self.vol_button.text.set_width_chars(6)
        self.vol_button.text.set_text(f"{icon} {level}%")

    def show_volume_osd(self):
        """Updates the sound icon now and pops the volume bar up above it."""
        self.update_volume()
        level, muted = self.volume()
        if level is None or self.open_flyout == "volume":
            return
        if not hasattr(self, "osd"):
            self.osd = VolumeOsd()
        # Centered over the sound icon (the bar is anchored to the right edge).
        alloc = self.vol_button.get_allocation()
        right = self.get_allocated_width() - (alloc.x + alloc.width // 2) - 115
        self.osd.show_level(level, muted, right)

    def on_volume_scroll(self, _w, event):
        step = "5%+" if event.direction == Gdk.ScrollDirection.UP or event.delta_y < 0 else "5%-"
        run("wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", step)
        self.show_volume_osd()
        return True

    def network(self):
        """('ethernet'|'wifi'|None, connection name)."""
        for line in run("nmcli", "-t", "-f", "TYPE,STATE,CONNECTION", "device").splitlines():
            kind, state, conn = (line.split(":", 2) + ["", ""])[:3]
            if state == "connected" and kind in ("ethernet", "wifi"):
                return kind, conn
        return None, ""

    def update_network(self):
        kind, _ = self.network()
        self.net_button.text.set_text({"ethernet": ICON_ETHERNET, "wifi": ICON_WIFI}.get(kind, ICON_OFFLINE))

    def on_tray_change(self):
        if self.open_flyout == "tray":
            self.fill_tray(self.flyouts["tray"])

    # --- Flyouts ---

    def toggle(self, name):
        if self.open_flyout == name:
            self.close_flyout()
            return
        self.close_flyout()
        fly = self.flyouts[name]
        fly.clear()
        getattr(self, "fill_" + name)(fly)
        if name == "tray":
            # Center the pop-up over the ^ button.
            x, _ = self.tray_button.translate_coordinates(self, 0, 0)
            width = max(fly.get_preferred_width()[1], 1)
            fly.set_left(x + self.tray_button.get_allocated_width() // 2 - width // 2)
        self.catcher.show_all()
        fly.show_all()
        fly.present()
        self.open_flyout = name
        for key, button in list(self.flyout_buttons.items()) + [("search", self.search_button)]:
            if not button:
                continue
            ctx = button.get_style_context()
            (ctx.add_class if key == name else ctx.remove_class)("open")

    def close_flyout(self):
        if self.open_flyout:
            self.flyouts[self.open_flyout].hide()
            for button in list(self.flyout_buttons.values()) + [self.search_button]:
                if button:
                    button.get_style_context().remove_class("open")
        self.open_flyout = None
        self.catcher.hide()

    def on_flyout_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close_flyout()
            return True
        return False

    def row_button(self, text, callback, *classes):
        button = Gtk.Button(label=text)
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.get_style_context().add_class("row")
        for c in classes:
            button.get_style_context().add_class(c)
        child = button.get_child()
        if isinstance(child, Gtk.Label):
            child.set_xalign(0)
            child.set_ellipsize(Pango.EllipsizeMode.END)
        button.connect("clicked", lambda *_: callback())
        return button

    # Search: apps and files, like the Windows search box.
    def fill_search(self, fly):
        fly.set_size_request(520, 460)
        entry = Gtk.SearchEntry()
        entry.set_placeholder_text("Type to search apps and files")
        results = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        scroll.add(results)
        fly.box.pack_start(entry, False, False, 0)
        fly.box.pack_start(scroll, True, True, 0)
        files = self.home_files()

        def show(*_):
            for child in results.get_children():
                results.remove(child)
            query = entry.get_text().strip().casefold()
            first = None
            apps = []
            for app_id, info in self.apps.visible():
                hay = " ".join(filter(None, [info.get_display_name(), info.get_generic_name(),
                                             " ".join(info.get_keywords() or []), app_id])).casefold()
                if query in hay:
                    starts = info.get_display_name().casefold().startswith(query)
                    apps.append((not starts, info.get_display_name().casefold(), app_id, info))
            apps.sort()
            if not query:
                results.pack_start(label("All apps", "section"), False, False, 0)
            elif apps:
                results.pack_start(label("Apps", "section"), False, False, 0)
            for _, _, app_id, info in apps[: None if not query else 8]:
                b = self.result_row(info.get_display_name(), info.get_icon(),
                                    lambda a=app_id: (self.apps.launch(a), self.close_flyout()))
                results.pack_start(b, False, False, 0)
                first = first or b
            matches = [f for f in files if query in os.path.basename(f).casefold()][:8] if query else []
            if matches:
                results.pack_start(label("Files", "section"), False, False, 0)
            for path in matches:
                b = self.result_row(os.path.basename(path), Gio.ThemedIcon.new("text-x-generic"),
                                    lambda p=path: (spawn("xdg-open", os.path.join(HOME, p)), self.close_flyout()),
                                    subtitle=os.path.dirname(path))
                results.pack_start(b, False, False, 0)
                first = first or b
            if query and first is None:
                results.pack_start(label(f"No results for “{entry.get_text().strip()}”", "empty"),
                                   False, False, 12)
            results.show_all()
            entry.first = first

        entry.first = None
        entry.connect("search-changed", show)
        entry.connect("activate", lambda *_: entry.first and entry.first.clicked())
        show()
        GLib.idle_add(entry.grab_focus)

    def result_row(self, text, icon, callback, subtitle=None):
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.get_style_context().add_class("row")
        box = Gtk.Box(spacing=10)
        image = Gtk.Image()
        if icon:
            image.set_from_gicon(icon, Gtk.IconSize.LARGE_TOOLBAR)
            image.set_pixel_size(ICON_SIZE)
        box.pack_start(image, False, False, 0)
        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        name = Gtk.Label(label=text, xalign=0)
        name.set_ellipsize(Pango.EllipsizeMode.END)
        text_box.pack_start(name, False, False, 0)
        if subtitle:
            sub = label(subtitle, "subtitle")
            sub.set_xalign(0)
            sub.set_ellipsize(Pango.EllipsizeMode.END)
            text_box.pack_start(sub, False, False, 0)
        box.pack_start(text_box, True, True, 0)
        button.add(box)
        button.connect("clicked", lambda *_: callback())
        return button

    def home_files(self):
        stamp, files = self.files_cache
        if time.monotonic() - stamp > 30:
            out = run("fd", "--type", "f", "--base-directory", HOME, "--exclude", "Games", "--exclude", "Steam")
            files = out.splitlines()
            self.files_cache = (time.monotonic(), files)
        return files

    # Hidden icons, like the ^ on Windows.
    def fill_tray(self, fly):
        fly.clear()
        items = list(self.tray.items.values())
        if not items:
            fly.box.pack_start(label("No hidden icons", "empty"), False, False, 4)
        grid = Gtk.FlowBox()
        grid.set_max_children_per_line(4)
        grid.set_selection_mode(Gtk.SelectionMode.NONE)
        for item in items:
            button = Gtk.Button()
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.get_style_context().add_class("tray-icon")
            button.add(self.tray.icon_widget(item))
            button.set_tooltip_text(item.get("Title") or "")

            def on_press(widget, event, it=item):
                if event.button == 3 or it.get("ItemIsMenu"):
                    self.tray.context_menu(it, widget, event, done=lambda: after_menu(self.close_flyout))
                elif event.button == 1:
                    self.tray.activate(it)
                    self.close_flyout()
                return True
            button.connect("button-press-event", on_press)
            grid.add(button)
        fly.box.pack_start(grid, False, False, 0)
        fly.show_all()

    def fill_network(self, fly):
        fly.set_size_request(320, -1)
        GtkLayerShell.set_keyboard_mode(fly, GtkLayerShell.KeyboardMode.ON_DEMAND)
        kind, conn = self.network()
        status = {"ethernet": f"Wired: {conn}", "wifi": f"Wi-Fi: {conn}"}.get(kind, "Not connected")
        fly.box.pack_start(label("Network", "title"), False, False, 0)
        status_label = label(status, "status")
        status_label.set_xalign(0)
        fly.box.pack_start(status_label, False, False, 0)
        self.wifi_entry = None
        if "wifi" in run("nmcli", "-t", "-f", "TYPE", "device").split():
            self.wifi_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            fly.box.pack_start(self.wifi_box, False, False, 0)
            # Show what's already known right away, then scan in the background
            # and refresh the list when the scan is done.
            fields = ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list", "--rescan"]
            self.show_wifi(fly, run(*fields, "no"), scanning=True)
            run_async(fields + ["yes"], lambda _ok, out: self.open_flyout == "network"
                      and not self.wifi_entry and self.show_wifi(fly, out, scanning=False))
        fly.box.pack_start(Gtk.Separator(), False, False, 0)
        fly.box.pack_start(self.row_button("Network settings", lambda: (spawn("kitty", "-e", "nmtui"),
                                                                        self.close_flyout())), False, False, 0)

    def show_wifi(self, fly, listing, scanning):
        for child in self.wifi_box.get_children():
            child.destroy()
        nets = {}
        for line in listing.splitlines():
            in_use, ssid, signal_, security = (nmcli_fields(line) + ["", "", "", ""])[:4]
            if not ssid:
                continue
            strength = int(signal_) if signal_.isdigit() else 0
            old = nets.get(ssid)
            if not old or strength > old["signal"] or in_use == "*":
                nets[ssid] = {"ssid": ssid, "signal": strength, "in_use": in_use == "*" or bool(old and old["in_use"]),
                              "secure": security not in ("", "--")}
        if not nets:
            text = "Looking for networks…" if scanning else "No Wi-Fi networks found"
            empty = label(text, "empty")
            empty.set_xalign(0)
            self.wifi_box.pack_start(empty, False, False, 4)
        for net in sorted(nets.values(), key=lambda n: (not n["in_use"], -n["signal"])):
            self.wifi_box.pack_start(self.wifi_row(fly, net), False, False, 0)
        self.wifi_box.show_all()

    def wifi_row(self, fly, net):
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.get_style_context().add_class("row")
        row = Gtk.Box(spacing=10)
        bars = ICON_WIFI_BARS[min(3, net["signal"] // 25)]
        row.pack_start(label(bars, "wifi-bars"), False, False, 0)
        name = label(net["ssid"])
        name.set_xalign(0)
        name.set_ellipsize(Pango.EllipsizeMode.END)
        row.pack_start(name, True, True, 0)
        if net["in_use"]:
            row.pack_start(label("Connected", "status"), False, False, 0)
        if net["secure"]:
            lock = label(ICON_LOCK, "status")
            lock.set_tooltip_text("Needs a password")
            row.pack_start(lock, False, False, 0)
        button.add(row)
        button.set_tooltip_text(f"Signal {net['signal']}%")
        button.connect("clicked", lambda b: self.join_wifi(fly, net, b))
        return button

    def join_wifi(self, fly, net, button):
        ssid = net["ssid"]
        if net["in_use"]:
            return
        known = ssid in run("nmcli", "-t", "-f", "NAME", "connection", "show").splitlines()
        if known or not net["secure"]:
            self.connect_wifi(ssid, known=known)
            return
        # One password box, right under the network that was clicked.
        if self.wifi_entry:
            self.wifi_entry.destroy()
        entry = Gtk.Entry(visibility=False, placeholder_text=f"Password for {ssid}, then Enter")
        entry.set_margin_start(8)
        entry.set_margin_end(8)
        entry.connect("activate", lambda e: e.get_text() and self.connect_wifi(ssid, e.get_text()))
        self.wifi_entry = entry
        self.wifi_box.pack_start(entry, False, False, 4)
        self.wifi_box.reorder_child(entry, self.wifi_box.get_children().index(button) + 1)
        GtkLayerShell.set_keyboard_mode(fly, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        entry.show()
        entry.grab_focus()

    def connect_wifi(self, ssid, password=None, known=False):
        if known:
            cmd = ["nmcli", "connection", "up", "id", ssid]
        else:
            cmd = ["nmcli", "device", "wifi", "connect", ssid] + (["password", password] if password else [])

        def finished(ok, _out):
            if ok:
                spawn("notify-send", "-t", "3000", "Wi-Fi", f"Connected to {ssid}")
            else:
                spawn("notify-send", "Wi-Fi", f"Couldn't connect to {ssid}."
                      + ("" if known else " Check the password and try again."))
                if not known:  # don't keep a saved network with a wrong password
                    run_async(["nmcli", "connection", "delete", "id", ssid])
            self.update_network()
        spawn("notify-send", "-t", "3000", "Wi-Fi", f"Connecting to {ssid}…")
        run_async(cmd, finished)
        self.close_flyout()

    def fill_volume(self, fly):
        fly.set_size_request(320, -1)
        fly.box.pack_start(label("Volume", "title"), False, False, 0)
        level, muted = self.volume()
        row = Gtk.Box(spacing=8)
        mute = Gtk.ToggleButton(label=ICON_MUTED if muted else ICON_VOLUME[2])
        mute.set_active(muted)
        mute.get_style_context().add_class("mute")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_value(level or 0)
        scale.set_draw_value(True)
        scale.set_value_pos(Gtk.PositionType.RIGHT)
        scale.set_hexpand(True)

        def set_level(s):
            run("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{int(s.get_value())}%")
            self.update_volume()

        def set_mute(b):
            run("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if b.get_active() else "0")
            b.set_label(ICON_MUTED if b.get_active() else ICON_VOLUME[2])
            self.update_volume()
        scale.connect("value-changed", set_level)
        mute.connect("toggled", set_mute)
        row.pack_start(mute, False, False, 0)
        row.pack_start(scale, True, True, 0)
        fly.box.pack_start(row, False, False, 0)

        fly.box.pack_start(label("Output", "section"), False, False, 0)
        current = run("pactl", "get-default-sink").strip()
        try:
            sinks = json.loads(run("pactl", "-f", "json", "list", "sinks") or "[]")
        except ValueError:
            sinks = []
        group = None
        for sink in sinks:
            radio = Gtk.RadioButton.new_with_label_from_widget(group, sink.get("description", sink["name"]))
            group = group or radio
            radio.set_active(sink["name"] == current)
            radio.connect("toggled", lambda r, n=sink["name"]: r.get_active() and run("pactl", "set-default-sink", n))
            fly.box.pack_start(radio, False, False, 0)

    def fill_clock(self, fly):
        fly.box.pack_start(label(time.strftime("%A, %B %-d"), "title"), False, False, 0)
        fly.box.pack_start(Gtk.Calendar(), False, False, 0)

    def fill_power(self, fly):
        fly.set_size_request(220, -1)
        for text, cmd in (("Lock", ["hyprlock"]), ("Restart", ["systemctl", "reboot"]),
                          ("Shut down", ["systemctl", "poweroff"])):
            fly.box.pack_start(self.row_button(text, lambda c=cmd: (self.close_flyout(), spawn(*c))),
                               False, False, 0)

    @staticmethod
    def start_clipboard_history():
        """Keeps everything you copy (text and pictures, the last 50) for Win+V.
        Started here rather than at login, so it also starts after an update."""
        for kind in ("text", "image"):
            if run("pgrep", "-u", str(os.getuid()), "-f", f"wl-paste --type {kind} --watch cliphist").strip():
                continue
            spawn("wl-paste", "--type", kind, "--watch", "cliphist", "-max-items", "50", "store")

    # Clipboard history (Win+V), like Windows: the last things you copied
    # (cliphist keeps them). Click one, or pick it and press Enter, to paste it.
    def fill_clipboard(self, fly):
        # A fixed size, like search: a pop-up that grows with its content can
        # end up with clicks landing in the wrong place.
        fly.set_size_request(400, 480)
        active = self.screen.get_active_window()
        self.paste_into = list(active.get_class_ids() or []) if active else []
        head = Gtk.Box()
        head.pack_start(label("Clipboard", "title"), False, False, 0)
        entries = [line for line in run("cliphist", "list").splitlines() if "\t" in line][:CLIP_ITEMS]
        if entries:
            head.pack_end(self.row_button("Clear all", self.clear_clipboard), False, False, 0)
        fly.box.pack_start(head, False, False, 0)
        if not entries:
            empty = label("Nothing copied yet. Things you copy show up here.", "empty")
            empty.set_xalign(0)
            fly.box.pack_start(empty, False, False, 4)
            return
        items = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        items.get_style_context().add_class("clipboard")
        rows = [self.clip_row(line) for line in entries]
        for row in rows:
            items.pack_start(row, False, False, 0)
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_vexpand(True)
        scroller.add(items)
        fly.box.pack_start(scroller, True, True, 0)
        GLib.idle_add(rows[0].paste.grab_focus)

    def clip_row(self, line):
        """One item: click it (or Enter) to paste, ✕ (or Delete) to remove it."""
        row = Gtk.Box(spacing=0)
        row.get_style_context().add_class("clip-row")
        _id, _, preview = line.partition("\t")
        paste = Gtk.Button()
        paste.set_relief(Gtk.ReliefStyle.NONE)
        paste.get_style_context().add_class("clip-item")
        picture = self.clip_picture(line) if preview.startswith("[[ binary data") else None
        if picture:
            content = Gtk.Image.new_from_pixbuf(picture)
            content.set_halign(Gtk.Align.START)
        else:
            content = Gtk.Label(label=preview.strip(), xalign=0)
            content.set_line_wrap(True)
            content.set_lines(3)
            content.set_ellipsize(Pango.EllipsizeMode.END)
            content.set_max_width_chars(40)
        paste.add(content)
        paste.connect("clicked", lambda _b: self.paste_clip(line))
        paste.connect("key-press-event", lambda _b, e: e.keyval == Gdk.KEY_Delete
                      and (self.delete_clip(line), True)[1])
        remove = Gtk.Button(label="✕")
        remove.set_relief(Gtk.ReliefStyle.NONE)
        remove.set_valign(Gtk.Align.START)
        remove.set_can_focus(False)
        remove.set_tooltip_text("Remove")
        remove.connect("clicked", lambda _b: self.delete_clip(line))
        row.pack_start(paste, True, True, 0)
        row.pack_end(remove, False, False, 0)
        row.paste = paste
        return row

    @staticmethod
    def clip_picture(line):
        try:
            data = subprocess.run(["cliphist", "decode"], input=line.encode(), capture_output=True,
                                  timeout=5).stdout
            loader = GdkPixbuf.PixbufLoader()
            loader.write(data)
            loader.close()
            pixbuf = loader.get_pixbuf()
        except (OSError, subprocess.SubprocessError, GLib.Error):
            return None
        scale = min(320 / pixbuf.get_width(), 120 / pixbuf.get_height(), 1)
        return pixbuf.scale_simple(max(1, int(pixbuf.get_width() * scale)),
                                   max(1, int(pixbuf.get_height() * scale)), GdkPixbuf.InterpType.BILINEAR)

    def paste_clip(self, line):
        """Puts the item back on the clipboard and pastes it into the window
        you were in (Ctrl+V, or Ctrl+Shift+V in a terminal)."""
        try:
            data = subprocess.run(["cliphist", "decode"], input=line.encode(), capture_output=True,
                                  timeout=5).stdout
            subprocess.run(["wl-copy"], input=data, timeout=5)
        except (OSError, subprocess.SubprocessError):
            return
        self.close_flyout()
        terminal = any(c.lower() in TERMINALS for c in self.paste_into)
        keys = ["-M", "ctrl", "-M", "shift", "-k", "v", "-m", "shift", "-m", "ctrl"] if terminal \
            else ["-M", "ctrl", "-k", "v", "-m", "ctrl"]
        # A moment for the window you were in to get the keyboard back.
        GLib.timeout_add(250, lambda: spawn("wtype", *keys) and False)

    def delete_clip(self, line):
        subprocess.run(["cliphist", "delete"], input=line.encode(), timeout=5)
        self.refill_clipboard()

    def clear_clipboard(self):
        run("cliphist", "wipe")
        self.refill_clipboard()

    def refill_clipboard(self):
        fly = self.flyouts["clipboard"]
        fly.clear()
        self.fill_clipboard(fly)
        fly.show_all()

    # Run (Win+R), like Windows: type a command, press Enter.
    def fill_run(self, fly):
        fly.set_size_request(420, 150)
        fly.box.pack_start(label("Run", "title"), False, False, 0)
        hint = label("An app, a command, a folder, or a website", "status")
        hint.set_xalign(0)
        fly.box.pack_start(hint, False, False, 0)
        entry = Gtk.Entry()
        fly.box.pack_start(entry, False, False, 0)
        problem = label("", "status")
        problem.set_xalign(0)
        fly.box.pack_start(problem, False, False, 0)

        def go(e):
            text = e.get_text().strip()
            if not text:
                return
            if self.run_text(text):
                self.close_flyout()
            else:
                problem.set_text(f"Can't find “{text}”. Check the name and try again.")
        entry.connect("activate", go)
        GLib.idle_add(entry.grab_focus)

    def run_text(self, text):
        """Win+R, like Windows: an app's name ("settings", "task manager"), a
        program or command ("firefox --private-window"), a folder or file
        ("~/Downloads"), or a website ("archlinux.org"). False if nothing fits."""
        path = find_path(os.path.expanduser(text))
        if path:
            # Folders in Files; files in whatever opens them.
            spawn(*(["nemo", path] if os.path.isdir(path) else ["xdg-open", path]))
            return True
        if re.match(r"^(https?://|www\.)|^[\w-]+(\.[\w-]+)+(/\S*)?$", text) and " " not in text:
            spawn("xdg-open", text if "://" in text else "https://" + text)
            return True
        try:
            program = shlex.split(text)[0]
        except ValueError:
            program = text.split()[0]
        if shutil.which(os.path.expanduser(program)):
            spawn("sh", "-c", text)
            return True
        # A folder or file in your home folder, without typing ~/ ("downloads").
        path = find_path(os.path.join(HOME, os.path.expanduser(text)))
        if path and path != HOME:
            spawn(*(["nemo", path] if os.path.isdir(path) else ["xdg-open", path]))
            return True
        # An app by its name: exact first, then the start of a name or word.
        wanted = text.casefold()
        apps = self.apps.visible()
        for test in (lambda name: name == wanted,
                     lambda name: name.startswith(wanted),
                     lambda name: any(word.startswith(wanted) for word in name.split())):
            for app_id, info in apps:
                if test(info.get_display_name().casefold()):
                    self.apps.launch(app_id)
                    return True
        return False


# --- SkorneXDesktop: desktop icons -----------------------------------------

DESKTOP_DIR = os.path.join(HOME, "Desktop")


def add_to_desktop(info):
    """Put an app shortcut on the desktop (a copy of its .desktop file)."""
    os.makedirs(DESKTOP_DIR, exist_ok=True)
    source = info.get_filename()
    if not source:
        return
    target = os.path.join(DESKTOP_DIR, os.path.basename(source))
    with open(source) as src, open(target, "w") as dst:
        dst.write(src.read())
    os.chmod(target, 0o755)


POSITIONS_FILE = os.path.join(CONFIG, "desktop.json")
# Wallpaper (from the Personalize settings module): path=... and mode=fill|fit|stretch|center.
WALLPAPER_FILE = os.path.join(CONFIG, "wallpaper")
CELL_W, CELL_H = 96, 100      # the desktop grid, like Windows' icon spacing
GRID_MARGIN = 12


class DesktopIcon(Gtk.EventBox):
    """One icon on the desktop: picture and name. Click to select, double-click
    to open, drag to move, right-click for options."""

    def __init__(self, desktop, key, name, icon, open_it, menu_items):
        super().__init__()
        self.desktop, self.key = desktop, key
        self.open_it, self.menu_items = open_it, menu_items
        self.get_style_context().add_class("desktop-icon")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.image = Gtk.Image()
        self.set_icon(icon)
        box.pack_start(self.image, False, False, 0)
        text = label(name, "desktop-label")
        text.set_max_width_chars(12)
        text.set_line_wrap(True)
        text.set_lines(2)
        text.set_ellipsize(Pango.EllipsizeMode.END)
        text.set_justify(Gtk.Justification.CENTER)
        box.pack_start(text, False, False, 0)
        self.add(box)
        self.set_size_request(CELL_W - 8, -1)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK
                        | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("button-press-event", self.on_press)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("button-release-event", self.on_release)
        self.connect("enter-notify-event", lambda *_: self.set_state_flags(Gtk.StateFlags.PRELIGHT, False))
        self.connect("leave-notify-event", lambda *_: self.unset_state_flags(Gtk.StateFlags.PRELIGHT))
        self.grab = None        # where in the icon you grabbed it
        self.dragging = False

    def set_icon(self, icon):
        if isinstance(icon, str):
            self.image.set_from_icon_name(icon, Gtk.IconSize.DIALOG)
        elif icon:
            self.image.set_from_gicon(icon, Gtk.IconSize.DIALOG)
        self.image.set_pixel_size(48)

    def on_press(self, _w, event):
        ctrl = event.state & Gdk.ModifierType.CONTROL_MASK
        if ctrl and event.button == 1:
            self.desktop.toggle_select(self)  # Ctrl+click adds or removes, like Windows
            return True
        if self not in self.desktop.selection:
            self.desktop.select(self)
        if event.type == DOUBLE_CLICK and event.button == 1:
            self.grab = None
            self.open_it()
        elif event.button == 1:
            self.grab = (event.x, event.y)
            self.dragging = False
        elif event.button == 3:
            menu = Gtk.Menu()
            items = self.menu_items
            files = [i for i in self.desktop.selection if i.path]
            if len(self.desktop.selection) > 1:
                items = [(f"Delete {len(files)} items", self.desktop.trash_selection)] if files else []
            for text, callback in items:
                item = Gtk.MenuItem(label=text)
                item.connect("activate", lambda _i, c=callback: after_menu(c))
                menu.append(item)
            menu.show_all()
            menu.attach_to_widget(self, None)
            menu.popup_at_pointer(event)
        return True

    def pointer(self, event):
        """Where the mouse is, in desktop coordinates."""
        return self.translate_coordinates(self.desktop.fixed, int(event.x), int(event.y))

    def on_motion(self, _w, event):
        if self.grab is None:
            return False
        if not self.dragging and (abs(event.x - self.grab[0]) > 6 or abs(event.y - self.grab[1]) > 6):
            self.dragging = True
            self.get_style_context().add_class("dragging")
        if self.dragging:
            x, y = self.pointer(event)
            self.desktop.drag_to(self, x - int(self.grab[0]), y - int(self.grab[1]),
                                 x - self.grab[0] + CELL_W / 2, y - self.grab[1] + CELL_H / 2)
        return True

    def on_release(self, _w, event):
        if self.dragging:
            x, y = self.pointer(event)
            self.desktop.drop(self, x - self.grab[0] + CELL_W / 2, y - self.grab[1] + CELL_H / 2)
        elif self.grab is not None and len(self.desktop.selection) > 1:
            self.desktop.select(self)  # a plain click on one of several: just that one
        self.grab = None
        self.dragging = False
        return True


class Wallpaper:
    """Paints the wallpaper (from the Personalize settings module) under the
    desktop, on every monitor, and follows its file live."""

    def __init__(self):
        self.widgets = []
        self.cache = {}
        self.monitor = Gio.File.new_for_path(WALLPAPER_FILE).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *_: GLib.idle_add(self.load))
        self.load()

    def attach(self, widget):
        self.widgets.append(widget)
        widget.connect("draw", self.draw)

    def load(self):
        conf = {}
        try:
            with open(WALLPAPER_FILE) as f:
                for line in f:
                    if "=" in line and not line.startswith("#"):
                        key, value = line.rstrip("\n").split("=", 1)
                        conf[key.strip()] = value.strip()
        except OSError:
            pass
        path = conf.get("path")
        self.wallpaper = (path, conf.get("mode", "fill")) if path and os.path.isfile(path) else None
        self.cache = {}
        for widget in self.widgets:
            widget.queue_draw()
        return False

    def draw(self, widget, cr):
        if not self.wallpaper:
            return False
        path, mode = self.wallpaper
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        key = (path, mode, w, h)
        if key not in self.cache:
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
            except GLib.Error as e:
                print(f"SkorneXDesktop: can't load wallpaper {path}: {e}", file=sys.stderr, flush=True)
                self.wallpaper = None
                return False
            pixbuf = pixbuf.apply_embedded_orientation() or pixbuf
            pw, ph = pixbuf.get_width(), pixbuf.get_height()
            if mode == "stretch":
                sw, sh = w, h
            else:
                scale = {"fit": min(w / pw, h / ph), "fill": max(w / pw, h / ph)}.get(mode, 1)
                sw, sh = max(1, round(pw * scale)), max(1, round(ph * scale))
            scaled = pixbuf if (sw, sh) == (pw, ph) else pixbuf.scale_simple(sw, sh, GdkPixbuf.InterpType.BILINEAR)
            self.cache[key] = (scaled, (w - sw) // 2, (h - sh) // 2)
        scaled, x, y = self.cache[key]
        Gdk.cairo_set_source_pixbuf(cr, scaled, x, y)
        cr.paint()
        return False


class Backdrop(Gtk.Window):
    """The background color and wallpaper on the other monitors (the desktop
    icons live on the main one)."""

    def __init__(self, app, monitor, wallpaper):
        super().__init__(application=app)
        make_layer(self, GtkLayerShell.Layer.BOTTOM,
                   [GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                    GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT],
                   namespace="skornex-desktop", monitor=monitor)
        GtkLayerShell.set_exclusive_zone(self, -1)  # the whole screen
        self.get_style_context().add_class("desktop")
        area = Gtk.DrawingArea()
        wallpaper.attach(area)
        self.add(area)
        self.show_all()


class Desktop(Gtk.Window):
    """Desktop icons, under all windows: the Recycle Bin plus everything in
    ~/Desktop (files, folders, app shortcuts), like Windows. Drag icons
    anywhere; they snap to a grid and stay where you put them. Right-click a
    taskbar app and pick "Add to desktop" to add a shortcut."""

    def __init__(self, app):
        super().__init__(application=app)
        # The whole screen (minus the taskbar), so icons can go anywhere.
        make_layer(self, GtkLayerShell.Layer.BOTTOM,
                   [GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                    GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT],
                   namespace="skornex-desktop")
        # It also paints the background color (no separate background program).
        self.get_style_context().add_class("desktop")
        # Clicking empty desktop clears the selection.
        background = Gtk.EventBox()
        background.set_visible_window(False)
        background.add_events(Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK)
        background.connect("button-press-event", self.on_background_press)
        background.connect("motion-notify-event", self.on_band_motion)
        background.connect("button-release-event", self.on_band_release)
        self.band = None  # (x0, y0, x1, y1) while drag-selecting
        self.fixed = Gtk.Fixed()
        background.add(self.fixed)
        self.add(background)
        # The wallpaper is painted under the icons; other monitors get a backdrop.
        self.wallpaper = Wallpaper()
        self.wallpaper.attach(self.fixed)
        self.fixed.connect_after("draw", self.draw_band)  # over the icons
        display = Gdk.Display.get_default()
        self.backdrops = [Backdrop(app, m, self.wallpaper)
                          for m in (display.get_monitor(i) for i in range(display.get_n_monitors()))
                          if m != main_monitor()]

        self.icons = {}
        self.selection = []
        self.positions = self.load_positions()
        self.trash = DesktopIcon(self, "::trash", "Recycle Bin", "user-trash",
                                 lambda: spawn("nemo", "trash:///"),
                                 [("Open", lambda: spawn("nemo", "trash:///")),
                                  ("Empty Recycle Bin", self.confirm_empty)])
        os.makedirs(DESKTOP_DIR, exist_ok=True)
        self.monitor = Gio.File.new_for_path(DESKTOP_DIR).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *_: GLib.idle_add(self.refresh))
        self.screen_size = None
        self.connect("size-allocate", self.on_size)
        self.refresh()
        self.update_trash()
        GLib.timeout_add_seconds(3, self.update_trash)
        self.show_all()
        print("SkorneXDesktop started", file=sys.stderr, flush=True)

    # --- Saved positions: {"name": [column, row]} ---

    @staticmethod
    def load_positions():
        try:
            with open(POSITIONS_FILE) as f:
                return {k: tuple(v) for k, v in json.load(f).items()}
        except (OSError, ValueError):
            return {}

    def save_positions(self):
        os.makedirs(CONFIG, exist_ok=True)
        with open(POSITIONS_FILE, "w") as f:
            json.dump({k: list(v) for k, v in self.positions.items()}, f, indent=1)

    def grid_size(self):
        width, height = self.screen_size
        cols = max(1, (width - GRID_MARGIN) // CELL_W)
        rows = max(1, (height - GRID_MARGIN) // CELL_H)
        return cols, rows

    def free_cell(self, taken):
        """The first empty spot, top to bottom then left to right, like Windows."""
        cols, rows = self.grid_size()
        for col in range(cols):
            for row in range(rows):
                if (col, row) not in taken:
                    return col, row
        return 0, 0

    def on_size(self, _w, alloc):
        # Only when the screen size actually changes (moving icons also
        # reports a size, and reacting to that would loop forever).
        size = (alloc.width, alloc.height)
        if size != self.screen_size:
            self.screen_size = size
            self.layout()

    def layout(self):
        """Put every icon in its saved spot; new ones go in the first free spot."""
        if not self.screen_size or self.screen_size[0] < CELL_W:
            return      # not on screen yet; this runs again once it is
        taken = {}
        for key in self.icons:
            pos = self.positions.get(key)
            if pos and pos not in taken.values():
                taken[key] = pos
        changed = False
        for key in self.icons:
            if key not in taken:
                taken[key] = self.free_cell(set(taken.values()))
                changed = True
        for key, icon in self.icons.items():
            col, row = taken[key]
            x, y = GRID_MARGIN + col * CELL_W, GRID_MARGIN + row * CELL_H
            if (self.fixed.child_get_property(icon, "x"), self.fixed.child_get_property(icon, "y")) != (x, y):
                self.fixed.move(icon, x, y)
        if changed or taken != self.positions:
            self.positions = {k: v for k, v in taken.items()}
            self.save_positions()

    def cell_at(self, x, y):
        cols, rows = self.grid_size()
        return (min(cols - 1, max(0, int((x - GRID_MARGIN) // CELL_W))),
                min(rows - 1, max(0, int((y - GRID_MARGIN) // CELL_H))))

    def over_trash(self, icon, x, y):
        """True when dropping here would put files in the Recycle Bin. Never
        for the Recycle Bin itself, which just moves."""
        dragged = self.selection if icon in self.selection else [icon]
        return self.trash not in dragged and self.cell_at(x, y) == self.positions.get(self.trash.key)

    def drag_to(self, icon, left, top, x, y):
        """Moves the dragged icons with the mouse (all selected ones together)."""
        old = self.fixed.child_get_property(icon, "x"), self.fixed.child_get_property(icon, "y")
        dx, dy = max(0, left) - old[0], max(0, top) - old[1]
        for i in (self.selection if icon in self.selection else [icon]):
            i.get_style_context().add_class("dragging")
            self.fixed.move(i, max(0, self.fixed.child_get_property(i, "x") + dx),
                            max(0, self.fixed.child_get_property(i, "y") + dy))
        ctx = self.trash.get_style_context()
        (ctx.add_class if self.over_trash(icon, x, y) else ctx.remove_class)("drop-target")

    def drop(self, icon, x, y):
        """Icons were dragged here. On the Recycle Bin: they're deleted (to the
        Recycle Bin). Otherwise they snap to the grid, keeping their places
        relative to each other; one icon swaps with whatever is there."""
        dragged = self.selection if icon in self.selection else [icon]
        for i in dragged:
            i.get_style_context().remove_class("dragging")
        self.trash.get_style_context().remove_class("drop-target")
        if self.over_trash(icon, x, y):
            self.layout()  # back in place until the files are gone
            for i in dragged:
                if i.path:
                    self.remove_file(Gio.File.new_for_path(i.path))
            self.select(None)
            return
        col, row = self.cell_at(x, y)
        old = self.positions.get(icon.key)
        if len(dragged) == 1:
            for key, pos in self.positions.items():
                if pos == (col, row) and key != icon.key and old:
                    self.positions[key] = old
            self.positions[icon.key] = (col, row)
        else:
            cols, rows = self.grid_size()
            dc, dr = (col - old[0], row - old[1]) if old else (0, 0)
            moving = {i.key for i in dragged}
            taken = {pos for key, pos in self.positions.items() if key not in moving}
            for i in dragged:
                c, r = self.positions.get(i.key, (0, 0))
                spot = (min(cols - 1, max(0, c + dc)), min(rows - 1, max(0, r + dr)))
                if spot in taken:
                    spot = self.free_cell(taken)
                self.positions[i.key] = spot
                taken.add(spot)
        self.save_positions()
        self.layout()

    def select(self, icon):
        """Selects just this icon (None: nothing)."""
        self.set_selection([icon] if icon else [])
        return False

    def toggle_select(self, icon):
        self.set_selection([i for i in self.selection if i is not icon] if icon in self.selection
                           else self.selection + [icon])

    def set_selection(self, icons):
        for i in self.selection:
            if i not in icons:
                i.get_style_context().remove_class("selected")
        for i in icons:
            i.get_style_context().add_class("selected")
        self.selection = list(icons)

    def trash_selection(self):
        for i in list(self.selection):
            if i.path:
                self.remove_file(Gio.File.new_for_path(i.path))
        self.select(None)

    # --- Drag-select: a box on the empty desktop selects what it touches ---

    def on_band_motion(self, _w, event):
        if not self.band:
            return False
        x0, y0 = self.band[:2]
        self.band = (x0, y0, event.x, event.y)
        left, right = sorted((x0, event.x))
        top, bottom = sorted((y0, event.y))
        hit = []
        for icon in self.icons.values():
            # Where the icon was placed (its allocation can lag behind a move).
            x, y = self.fixed.child_get_property(icon, "x"), self.fixed.child_get_property(icon, "y")
            if x < right and left < x + CELL_W - 8 and y < bottom and top < y + CELL_H - 12:
                hit.append(icon)
        self.set_selection(self.band_base + [i for i in hit if i not in self.band_base])
        self.fixed.queue_draw()
        return True

    def on_band_release(self, _w, _event):
        if self.band:
            self.band = None
            self.fixed.queue_draw()
        return False

    def draw_band(self, _w, cr):
        if not self.band or self.band[2] is None:
            return False
        x0, y0, x1, y1 = self.band
        color = self.get_style_context().lookup_color("theme_selected_bg_color")
        rgba = color[1] if color[0] else Gdk.RGBA(0.6, 0.6, 0.65, 1)
        cr.rectangle(min(x0, x1) + 0.5, min(y0, y1) + 0.5, abs(x1 - x0), abs(y1 - y0))
        cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 0.2)
        cr.fill_preserve()
        cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 0.8)
        cr.set_line_width(1)
        cr.stroke()
        return False

    # --- What's on the desktop ---

    def refresh(self):
        wanted = {"::trash": None}
        try:
            names = sorted(n for n in os.listdir(DESKTOP_DIR) if not n.startswith("."))
        except OSError:
            names = []
        for name in names:
            wanted[name] = os.path.join(DESKTOP_DIR, name)
        for key in list(self.icons):
            if key not in wanted:
                gone = self.icons.pop(key)
                if gone in self.selection:
                    self.selection.remove(gone)
                self.fixed.remove(gone)
                self.positions.pop(key, None)
        for key, path in wanted.items():
            if key not in self.icons:
                icon = self.trash if key == "::trash" else self.make_icon(key, path)
                icon.path = path  # None for the Recycle Bin
                self.icons[key] = icon
                self.fixed.put(icon, 0, 0)
        self.fixed.show_all()
        self.layout()
        return False

    def on_background_press(self, _w, event):
        """Click on empty desktop: clear the selection. Right-click: New folder,
        New text document, Settings, like Windows. Drag: select icons with a box."""
        ctrl = event.state & Gdk.ModifierType.CONTROL_MASK
        if not ctrl:
            self.select(None)
        if event.button == 1:
            self.band = (event.x, event.y, None, None)
            self.band_base = list(self.selection)  # Ctrl+drag adds to what's selected
            return True
        if event.button != 3:
            return False
        menu = Gtk.Menu()
        for icon, text, callback in (("folder-new", "New folder", lambda: self.new_item(event, folder=True)),
                                     ("document-new", "New text document",
                                      lambda: self.new_item(event, folder=False)),
                                     (None, None, None),
                                     ("preferences-system", "Settings", lambda: spawn("skornex-settings"))):
            if text is None:
                menu.append(Gtk.SeparatorMenuItem())
                continue
            # An icon on the left of each item, like Windows.
            item = Gtk.MenuItem()
            row = Gtk.Box(spacing=10)
            row.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU), False, False, 0)
            row.pack_start(Gtk.Label(label=text, xalign=0), True, True, 0)
            item.add(row)
            item.connect("activate", lambda _i, c=callback: after_menu(c))
            menu.append(item)
        menu.show_all()
        menu.attach_to_widget(self, None)
        menu.popup_at_pointer(event)
        return True

    def new_item(self, event, folder):
        """Makes "New folder" / "New text document.txt" where you right-clicked,
        then asks for its name."""
        base, ext = ("New folder", "") if folder else ("New text document", ".txt")
        name, n = base + ext, 2
        while os.path.exists(os.path.join(DESKTOP_DIR, name)):
            name, n = f"{base} ({n}){ext}", n + 1
        path = os.path.join(DESKTOP_DIR, name)
        try:
            if folder:
                os.mkdir(path)
            else:
                open(path, "x").close()
        except OSError:
            return
        if self.screen_size:
            cols, rows = self.grid_size()
            cell = (min(cols - 1, max(0, int((event.x - GRID_MARGIN) // CELL_W))),
                    min(rows - 1, max(0, int((event.y - GRID_MARGIN) // CELL_H))))
            if cell not in self.positions.values():
                self.positions[name] = cell
        self.refresh()
        self.rename(path)

    def rename(self, path):
        old = os.path.basename(path)
        dialog = Gtk.Dialog(title="Rename", modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Rename", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        entry = Gtk.Entry(text=old, activates_default=True, width_chars=36)
        box = dialog.get_content_area()
        box.set_border_width(12)
        box.pack_start(entry, False, False, 0)
        dialog.show_all()
        # Select the name without the extension, like Windows.
        stem = os.path.splitext(old)[0] if os.path.isfile(path) else old
        GLib.idle_add(entry.select_region, 0, len(stem))
        if dialog.run() == Gtk.ResponseType.OK:
            new = entry.get_text().strip().replace("/", "-")
            target = os.path.join(DESKTOP_DIR, new)
            if new and new != old and not os.path.exists(target):
                try:
                    os.rename(path, target)
                    if old in self.positions:
                        self.positions[new] = self.positions.pop(old)
                        self.save_positions()
                except OSError:
                    pass
        dialog.destroy()

    def make_icon(self, key, path):
        gfile = Gio.File.new_for_path(path)
        if path.endswith(".desktop"):
            info = Gio.DesktopAppInfo.new_from_filename(path)
            if info:
                return DesktopIcon(self, key, info.get_display_name(), info.get_icon(),
                                   lambda: spawn("gio", "launch", path),
                                   [("Open", lambda: spawn("gio", "launch", path)),
                                    ("Remove from desktop", lambda: self.remove_file(gfile))])
        try:
            icon = gfile.query_info("standard::icon", Gio.FileQueryInfoFlags.NONE, None).get_icon()
        except GLib.Error:
            icon = "text-x-generic"
        return DesktopIcon(self, key, os.path.basename(path), icon, lambda: spawn("xdg-open", path),
                           [("Open", lambda: spawn("xdg-open", path)),
                            ("Show in Files", lambda: spawn("nemo", DESKTOP_DIR)),
                            ("Rename", lambda: self.rename(path)),
                            ("Delete", lambda: self.remove_file(gfile))])

    @staticmethod
    def remove_file(gfile):
        try:
            gfile.trash(None)   # to the Recycle Bin, like Windows
        except GLib.Error:
            pass

    def count(self):
        try:
            info = Gio.File.new_for_uri("trash:///").query_info("trash::item-count", Gio.FileQueryInfoFlags.NONE, None)
            return info.get_attribute_uint32("trash::item-count")
        except GLib.Error:
            return 0

    def update_trash(self):
        self.trash.set_icon("user-trash-full" if self.count() else "user-trash")
        return True

    def confirm_empty(self):
        n = self.count()
        if not n:
            return
        dialog = Gtk.MessageDialog(message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.NONE,
                                   text="Empty the Recycle Bin?")
        dialog.format_secondary_text(f"{n} item{'s' if n != 1 else ''} will be deleted for good.")
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Empty", Gtk.ResponseType.OK)
        if dialog.run() == Gtk.ResponseType.OK:
            run("gio", "trash", "--empty")
        dialog.destroy()
        self.update_trash()


# --- Start up ---------------------------------------------------------------

class SkorneXBar(Gtk.Application):
    def __init__(self, mode):
        app_id = "dev.skornex.Desktop" if mode == "desktop" else "dev.skornex.Bar"
        super().__init__(application_id=app_id, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.mode = mode
        self.bar = None
        self.desktop = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        settings = Gtk.Settings.get_default()
        settings.props.gtk_icon_theme_name = "Papirus-Dark"
        settings.props.gtk_application_prefer_dark_theme = True
        css = Gtk.CssProvider()
        try:
            css.load_from_path(STYLE_FILE)
        except GLib.Error as e:
            print(f"skornex-bar: no style ({e.message}); run skornex-theme", file=sys.stderr)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_USER)
        # A monitor plugged in or out: start over (autostart restarts us a
        # second later), so the taskbar and desktop land on the right screens.
        display = Gdk.Display.get_default()
        display.connect("monitor-added", lambda *_: GLib.timeout_add(500, self.quit))
        display.connect("monitor-removed", lambda *_: GLib.timeout_add(500, self.quit))
        # "raise" over D-Bus, for skornex-open: much faster than starting a
        # second skornex-bar just to pass the message on.
        raise_action = Gio.SimpleAction.new("raise", GLib.VariantType.new("s"))
        raise_action.connect("activate", lambda _a, param: self.raise_soon(*(param.get_string().split("|", 1) + [""])[:2]))
        self.add_action(raise_action)
        osd_action = Gio.SimpleAction.new("volume-osd", None)
        osd_action.connect("activate", lambda *_: self.bar and self.bar.show_volume_osd())
        self.add_action(osd_action)
        self.hold()

    def raise_soon(self, app_id, hint):
        """Raises right away and twice more, in case the app is still switching
        to the file or opening its window."""
        if self.bar:
            for delay in (60, 250, 600):
                GLib.timeout_add(delay, self.bar.raise_app, app_id, hint)

    def do_command_line(self, command_line):
        args = command_line.get_arguments()[1:]
        if self.mode == "desktop":
            self.desktop = self.desktop or Desktop(self)
            return 0
        if self.bar is None:
            self.bar = Bar(self)
        if args and args[0] in ("search", "power", "run", "clipboard"):
            self.bar.toggle(args[0])
        elif args[:1] == ["raise"] and len(args) >= 2:
            self.raise_soon(args[1], args[2] if len(args) > 2 else "")
        return 0


if __name__ == "__main__":
    sys.exit(SkorneXBar("desktop" if sys.argv[1:2] == ["desktop"] else "bar").run(sys.argv))
