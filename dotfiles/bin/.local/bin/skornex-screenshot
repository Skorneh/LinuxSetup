#!/usr/bin/env bash
# skornex-screenshot region  drag a box, copy to clipboard
# skornex-screenshot full    whole screen, copy to clipboard
# skornex-screenshot save    whole screen, saved to ~/Pictures/Screenshots
case "${1:-region}" in
    region)
        area="$(slurp)" || exit 0
        grim -g "$area" - | wl-copy --type image/png
        notify-send -t 2000 "Screenshot" "Copied to clipboard. Paste it anywhere, or in Paint." ;;
    full)
        grim - | wl-copy --type image/png
        notify-send -t 2000 "Screenshot" "Copied to clipboard. Paste it anywhere, or in Paint." ;;
    save)
        dir="$HOME/Pictures/Screenshots"
        mkdir -p "$dir"
        file="$dir/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"
        grim "$file" && notify-send -t 3000 "Screenshot" "Saved to $file" ;;
esac
