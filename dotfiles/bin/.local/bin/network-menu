#!/usr/bin/env bash
# Click the network icon on the taskbar.
# Shows your connection, nearby Wi-Fi to join, and a way into the full menu.
status="$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device | awk -F: '$3=="connected" {print $4 " (" $2 ")"}' | head -1)"
header="Connected: ${status:-nothing}"

wifi=""
if nmcli -t -f TYPE device | grep -qx wifi; then
    wifi="$(nmcli -t -f IN-USE,SSID,SIGNAL device wifi list --rescan auto \
        | awk -F: '$2!="" && !seen[$2]++ { printf "%s %s  %s%%\n", ($1=="*" ? "●" : " "), $2, $3 }')"
fi

choice="$(printf '%s\n%s\nMore settings…\n' "$header" "$wifi" | grep -v '^$' \
    | rofi -dmenu -i -p "Network")" || exit 0

case "$choice" in
    "Connected:"*) exit 0 ;;
    "More settings…") exec kitty -e nmtui ;;
esac

ssid="$(sed -E 's/^. (.*)  [0-9]+%$/\1/' <<<"$choice")"
# Known networks connect directly; new ones ask for the password.
if nmcli -t -f NAME connection show | grep -qxF "$ssid"; then
    nmcli connection up "$ssid" && notify-send "Network" "Connected to $ssid"
else
    pass="$(rofi -dmenu -password -p "Password for $ssid" < /dev/null)" || exit 0
    nmcli device wifi connect "$ssid" password "$pass" \
        && notify-send "Network" "Connected to $ssid" \
        || notify-send -u critical "Network" "Couldn't connect to $ssid"
fi
