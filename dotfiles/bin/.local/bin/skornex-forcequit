#!/usr/bin/env bash
# skornex-forcequit (Ctrl+Shift+Esc): a Mac-style Force Quit list.
# Shows each open app with its memory use. Pick one, confirm, and it's gone.

# Background pieces of the desktop itself, never listed.
skip='^(labwc|skornex-bar|dunst|swaybg|swayidle|hyprlock|rofi|wl-paste|polkit-gnome-au|Xwayland|xdg-desktop-por|pipewire|wireplumber|skornex-forceq)$'

# An "app" is a process with a window connection whose parent isn't one.
# Its memory includes all its child processes (Firefox tabs, game, etc.).
mapfile -t apps < <(
    ps -u "$USER" -o pid=,ppid=,rss=,comm= | while read -r pid ppid rss comm; do
        [[ "$comm" =~ $skip ]] && continue
        tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q '^WAYLAND_DISPLAY=' \
            && gui=1 || gui=0
        echo "$pid $ppid $rss $gui $comm"
    done | awk '
        { pid[NR]=$1; ppid[$1]=$2; rss[$1]=$3; gui[$1]=$4; name[$1]=$5 }
        END {
            for (i in pid) { p = pid[i]; q = p
                # add each process to the memory of every ancestor
                while (q in ppid) { total[q] += rss[p]; q = ppid[q] } }
            for (i in pid) { p = pid[i]
                if (gui[p] && !gui[ppid[p]])
                    printf "%-28s %6d MB  [%d]\n", name[p], total[p] / 1024, p }
        }' | sort -k2 -n -r
)

((${#apps[@]})) || { notify-send "Force Quit" "No apps are open."; exit 0; }

choice="$(printf '%s\n' "${apps[@]}" | rofi -dmenu -i -p "Force Quit")" || exit 0
pid="$(sed -E 's/.*\[([0-9]+)\]$/\1/' <<<"$choice")"
name="$(awk '{print $1}' <<<"$choice")"

confirm="$(printf 'Force quit %s\nCancel\n' "$name" | rofi -dmenu -p "Sure?")" || exit 0
[[ "$confirm" == "Force quit $name" ]] || exit 0

# Kill the app and everything it started, children first.
kill_tree() {
    local child
    for child in $(pgrep -P "$1"); do kill_tree "$child"; done
    kill -KILL "$1" 2>/dev/null
}
kill_tree "$pid"
notify-send "Force Quit" "$name was closed."
