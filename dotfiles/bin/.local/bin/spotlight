#!/usr/bin/env bash
# Ctrl+Space: search apps and files together, like Spotlight on a Mac.
# Run normally, it opens the search box. rofi then calls it again (with
# ROFI_RETV set) to list your files, and once more to open the one you pick.
if [[ -z "${ROFI_RETV:-}" ]]; then
    exec rofi -show combi -modes combi -combi-modes "drun,files:$0" \
        -combi-hide-mode-prefix -display-combi Search
fi

# A file was picked: open it with its usual app.
if [[ -n "${1:-}" ]]; then
    setsid -f xdg-open "$HOME/$1" >/dev/null 2>&1
    exit 0
fi

# List files in your home folder. Hidden folders (settings, caches) and
# game installs are skipped so results stay useful.
fd --type f --base-directory "$HOME" --exclude Games --exclude Steam 2>/dev/null
