#!/bin/sh
# skornex-open APP_ID COMMAND [ARGS...]: open files in an app that keeps one
# window (like Notepad), then bring that window to the front.
#
# On Wayland an app may only jump in front of others with a token from the
# program you clicked in. When an app hands a file to its already-open
# window, that token often gets lost, so double-clicking an open file in
# Files did nothing visible. SkorneXBar can always bring a window forward, so
# it does it instead.
app=$1
shift
echo "$(date '+%F %T') open $app: $*" >> "$HOME/.cache/skornex-open.log"
"$@" &
for last; do :; done
name=$(basename "${last:-}" 2>/dev/null | tr -d "'\\\\")
# Ask the running taskbar over D-Bus (instant), else start skornex-bar to ask.
gdbus call --session --dest dev.skornex.Bar --object-path /dev/skornex/Bar \
    --method org.gtk.Actions.Activate raise "[<'$app|$name'>]" "{}" >/dev/null 2>&1 \
    || exec "$HOME/.local/bin/skornex-bar" raise "$app" "$name"
