#!/usr/bin/env bash
# skornex-theme: apply ~/.config/skornex/colors to everything SkorneX themes.
# Fills in the templates in the repo's theme/templates/ folder and writes the
# results into ~/.config, then reloads whatever is running.
set -euo pipefail

colors="$HOME/.config/skornex/colors"
repo="$(cd "$(dirname "$(readlink -f "$colors")")/../../../.." && pwd)"
templates="$repo/theme/templates"

set -a
# shellcheck source=/dev/null
. "$colors"
set +a
vars='$BG $SURFACE $BORDER $MUTED $TEXT $ACCENT $URGENT'

while IFS= read -r -d '' template; do
    rel="${template#"$templates"/}"
    mkdir -p "$HOME/.config/$(dirname "$rel")"
    envsubst "$vars" < "$template" > "$HOME/.config/$rel"
done < <(find "$templates" -type f -print0)

# Reload what's running. Nothing to do outside a desktop session.
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    labwc -r 2>/dev/null || true
    pkill -f skornex-bar && (setsid -f "$HOME/.local/bin/skornex-bar" >/dev/null 2>&1)
    pkill -x dunst && (dunst >/dev/null 2>&1 &)
    pkill -x swaybg && (swaybg -c "#$BG" >/dev/null 2>&1 &)
    pkill -USR1 -x kitty || true
fi
echo "Colors applied."
