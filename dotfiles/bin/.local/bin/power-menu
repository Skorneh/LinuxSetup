#!/usr/bin/env bash
# Ctrl+Alt+Delete or the power icon on the taskbar.
# shellcheck source=../lib/rice/popup.sh
. ~/.local/lib/rice/popup.sh
popup_toggle
choice="$(printf 'Lock\nLog out\nRestart\nShut down\n' | popup_menu 8 "Power")" || exit 0
case "$choice" in
    "Lock")      hyprlock ;;
    "Log out")   labwc --exit ;;
    "Restart")   systemctl reboot ;;
    "Shut down") systemctl poweroff ;;
esac
