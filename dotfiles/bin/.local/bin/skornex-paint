             font-size: 9pt; color: #a1a1aa; }
.statusbar button { min-height: 0; min-width: 0; padding: 0 6px; }
"""


class PaintWindow(Gtk.ApplicationWindow):
    def __init__(self, app, path=None):
        super().__init__(application=app)
        self.set_default_size(1150, 760)
        self.set_icon_name("skornex-paint")

        self.surface = new_surface(*DEFAULT_SIZE)
        self.path = None
        self.modified = False
        self.undo_stack, self.redo_stack = [], []
        self.zoom = 1
        self.tool = "pencil"
        self.last_tool = "pencil"
        self.colors = [(0, 0, 0), (1, 1, 1)]
        self.color_slot = 0  # which of Color 1 / Color 2 a palette click sets
        self.custom_colors = []
        self.line_size = 3
        self.font_size = 14
        self.shape_fill = False

        self.sel = None        # [x, y, w, h] of the selection, in image pixels
        self.floating = None   # lifted or pasted pixels, drawn at sel's x, y
        self.text = None       # {"x", "y", "w", "s"} while typing text
        self.drag = None       # what the mouse is doing right now
        self.preview = None    # shape being dragged out

        self.build()
        self.connect("delete-event", self.on_delete)
        if path:
            self.load(path)
        self.update_title()
        self.update_canvas_size()

    # --- Layout ---

    def build(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)

        top = Gtk.Box(spacing=2)
        top.get_style_context().add_class("paint-top")
        menu = Gio.Menu()
        file_menu = Gio.Menu()
        for label, action in [("New", "new"), ("Open…", "open"), ("Save", "save"),
                              ("Save as…", "save-as")]:
            file_menu.append(label, "win." + action)
        exit_section = Gio.Menu()
        exit_section.append("Exit", "win.close")
        file_menu.append_section(None, exit_section)
        edit_menu = Gio.Menu()
        for label, action in [("Undo", "undo"), ("Redo", "redo")]:
            edit_menu.append(label, "win." + action)
        clip = Gio.Menu()
        for label, action in [("Cut", "cut"), ("Copy", "copy"), ("Paste", "paste"),
                              ("Select all", "select-all"), ("Delete selection", "delete")]:
            clip.append(label, "win." + action)
        edit_menu.append_section(None, clip)
        view_menu = Gio.Menu()
        for label, action in [("Zoom in", "zoom-in"), ("Zoom out", "zoom-out"),
                              ("Actual size (100%)", "zoom-reset")]:
            view_menu.append(label, "win." + action)
        menu.append_submenu("File", file_menu)
        menu.append_submenu("Edit", edit_menu)
        menu.append_submenu("View", view_menu)
        top.pack_start(Gtk.MenuBar.new_from_model(menu), False, False, 0)
        for icon, action, tip in [("document-save-symbolic", "save", "Save (Ctrl+S)"),
                                  ("edit-undo-symbolic", "undo", "Undo (Ctrl+Z)"),
                                  ("edit-redo-symbolic", "redo", "Redo (Ctrl+Y)")]:
            b = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.MENU)
            b.set_relief(Gtk.ReliefStyle.NONE)
            b.set_action_name("win." + action)
            b.set_tooltip_text(tip)
            top.pack_start(b, False, False, 0)
        root.pack_start(top, False, False, 0)

        # The ribbon is built after the canvas and status bar it updates.
        ribbon_slot = Gtk.Box()
        root.pack_start(ribbon_slot, False, False, 0)

        self.canvas = Gtk.DrawingArea()
        self.canvas.set_can_focus(True)
        self.canvas.set_halign(Gtk.Align.START)
        self.canvas.set_valign(Gtk.Align.START)
        self.canvas.set_margin_start(10)
        self.canvas.set_margin_top(10)
        self.canvas.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                               | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.KEY_PRESS_MASK
                               | Gdk.EventMask.LEAVE_NOTIFY_MASK | Gdk.EventMask.SCROLL_MASK)
        self.canvas.connect("draw", self.on_draw)
        self.canvas.connect("button-press-event", self.on_press)
        self.canvas.connect("motion-notify-event", self.on_motion)
        self.canvas.connect("button-release-event", self.on_release)
        self.canvas.connect("key-press-event", self.on_key)
        self.canvas.connect("leave-notify-event", lambda *_: self.pos_label.set_text(""))
        self.scroller = Gtk.ScrolledWindow()
        self.scroller.get_style_context().add_class("canvas-area")
        self.scroller.add(self.canvas)
        self.scroller.connect("scroll-event", self.on_scroll)
        root.pack_start(self.scroller, True, True, 0)

        status = Gtk.Box(spacing=24)
        status.get_style_context().add_class("statusbar")
        self.pos_label = Gtk.Label(xalign=0, width_chars=14)
        self.sel_label = Gtk.Label(xalign=0, width_chars=14)
        self.size_label = Gtk.Label(xalign=0, width_chars=16)
        for label in (self.pos_label, self.sel_label, self.size_label):
            status.pack_start(label, False, False, 0)
        self.zoom_label = Gtk.Label(label="100%", width_chars=6)
        zoom_in = Gtk.Button(label="+", relief=Gtk.ReliefStyle.NONE, action_name="win.zoom-in")
        zoom_out = Gtk.Button(label="−", relief=Gtk.ReliefStyle.NONE, action_name="win.zoom-out")
        status.pack_end(zoom_in, False, False, 0)
        status.pack_end(self.zoom_label, False, False, 0)
        status.pack_end(zoom_out, False, False, 0)
        root.pack_start(status, False, False, 0)
        ribbon_slot.pack_start(self.build_ribbon(), True, True, 0)

        for name, cb in [("new", self.new), ("open", self.open_dialog), ("save", self.save),
                         ("save-as", self.save_as), ("close", lambda: self.close()),
                         ("undo", self.undo), ("redo", self.redo), ("cut", self.cut),
                         ("copy", self.copy), ("paste", self.paste),
                         ("select-all", self.select_all), ("delete", self.delete_selection),
                         ("zoom-in", lambda: self.step_zoom(1)),
                         ("zoom-out", lambda: self.step_zoom(-1)),
                         ("zoom-reset", lambda: self.set_zoom(1))]:
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda _a, _p, cb=cb: cb())
            self.add_action(action)

    def tool_button(self, group, tool, painter, tip, big=False):
        button = Gtk.RadioButton.new_from_widget(group)
        button.set_mode(False)
        button.add(Icon(painter, 26 if big else 18))
        button.set_tooltip_text(tip)
        if big:
            button.get_style_context().add_class("big")
        button.connect("toggled", lambda b: b.get_active() and self.set_tool(tool))
        self.tool_buttons[tool] = button
        return button

    def plain_button(self, painter, tip, cb):
        button = Gtk.Button()
        button.add(Icon(painter, 18))
        button.set_tooltip_text(tip)
        button.connect("clicked", lambda _b: cb())
        return button

    def group(self, title, content):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.set_valign(Gtk.Align.CENTER)
        box.pack_start(content, True, True, 0)
        label = Gtk.Label(label=title)
        label.get_style_context().add_class("group-label")
        box.pack_end(label, False, False, 0)
        return box

    def build_ribbon(self):
        ribbon = Gtk.Box()
        ribbon.get_style_context().add_class("ribbon")
        self.tool_buttons = {}
        first = Gtk.RadioButton()  # hidden anchor for the radio group

        def add(title, content):
            if ribbon.get_children():
                ribbon.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)
            ribbon.pack_start(self.group(title, content), False, False, 0)

        sel = Gtk.Box()
        sel.pack_start(self.tool_button(first, "select", icon_select, "Select (drag a box)", big=True),
                       False, False, 0)
        add("Selection", sel)

        image = Gtk.Grid(row_spacing=2, column_spacing=2)
        image.attach(self.plain_button(icon_crop, "Crop to the selection", self.crop), 0, 0, 1, 1)
        image.attach(self.plain_button(icon_resize, "Resize", self.resize_dialog), 1, 0, 1, 1)
        rotate = Gtk.MenuButton()
        rotate.add(Icon(icon_rotate, 18))
        rotate.set_tooltip_text("Rotate or flip")
        rotate_menu = Gtk.Menu()
        for label, op in [("Rotate right 90°", "right"), ("Rotate left 90°", "left"),
                          ("Rotate 180°", "180"), ("Flip vertical", "flip-v"),
                          ("Flip horizontal", "flip-h")]:
            item = Gtk.MenuItem(label=label)
            item.connect("activate", lambda _i, op=op: self.transform(op))
            rotate_menu.append(item)
        rotate_menu.show_all()
        rotate.set_popup(rotate_menu)
        image.attach(rotate, 0, 1, 1, 1)
        add("Image", image)

        tools = Gtk.Grid(row_spacing=2, column_spacing=2)
        for i, (tool, painter, tip) in enumerate([
                ("pencil", icon_pencil, "Pencil"), ("fill", icon_fill, "Fill with color"),
                ("text", icon_text, "Text"), ("eraser", icon_eraser, "Eraser"),
                ("picker", icon_picker, "Color picker"), ("zoom", icon_zoom, "Magnifier")]):
            tools.attach(self.tool_button(first, tool, painter, tip), i % 3, i // 3, 1, 1)
        add("Tools", tools)

        brush = Gtk.Box()
        brush.pack_start(self.tool_button(first, "brush", icon_brush, "Brush", big=True), False, False, 0)
        add("Brushes", brush)

        shapes = Gtk.Box(spacing=6)
        grid = Gtk.Grid(row_spacing=0, column_spacing=0)
        for i, (kind, tip) in enumerate(SHAPES):
            grid.attach(self.tool_button(first, "shape:" + kind, shape_icon(kind), tip), i % 6, i // 6, 1, 1)
        shapes.pack_start(grid, False, False, 0)
        fill_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.fill_combo = Gtk.ComboBoxText()
        self.fill_combo.append_text("No fill")
        self.fill_combo.append_text("Solid fill")
        self.fill_combo.set_active(0)
        self.fill_combo.set_tooltip_text("Fill shapes with Color 2")
        self.fill_combo.connect("changed", lambda c: setattr(self, "shape_fill", c.get_active() == 1))
        fill_box.pack_start(self.fill_combo, False, False, 0)
        shapes.pack_start(fill_box, False, False, 0)
        add("Shapes", shapes)

        self.size_combo = Gtk.ComboBoxText()
        self.size_combo.connect("changed", self.on_size_changed)
        add("Size", self.size_combo)

        colors = Gtk.Box(spacing=8)
        slots = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.slot_swatches = []
        slot_group = None
        for i, tip in enumerate(["Color 1 (left click)", "Color 2 (right click)"]):
            b = Gtk.RadioButton.new_from_widget(slot_group)
            slot_group = slot_group or b
            b.set_mode(False)
            swatch = Swatch(self.colors[i], 26 if i == 0 else 20)
            self.slot_swatches.append(swatch)
            b.add(swatch)
            b.set_tooltip_text(tip)
            b.connect("toggled", lambda b, i=i: b.get_active() and setattr(self, "color_slot", i))
            slots.pack_start(b, False, False, 0)
        colors.pack_start(slots, False, False, 0)
        palette = Gtk.Grid(row_spacing=0, column_spacing=0)
        for i, value in enumerate(PALETTE):
            palette.attach(self.color_button(hex_rgb(value)), i % 10, i // 10, 1, 1)
        self.custom_buttons = []
        for i in range(10):
            b = self.color_button(None)
            self.custom_buttons.append(b)
            palette.attach(b, i, 2, 1, 1)
        colors.pack_start(palette, False, False, 0)
        edit = Gtk.Button()
        edit.add(Swatch(None, 26))
        rainbow = edit.get_child()
        rainbow.connect("draw", self.draw_rainbow)
        edit.set_tooltip_text("Edit colors")
        edit.connect("clicked", lambda _b: self.edit_colors())
        colors.pack_start(edit, False, False, 0)
        add("Colors", colors)

        self.tool_buttons["pencil"].set_active(True)
        self.fill_size_combo()
        return ribbon

    def color_button(self, rgb):
        button = Gtk.Button()
        button.add(Swatch(rgb, 16))
        button.connect("clicked", self.on_palette)
        button.connect("button-press-event", self.on_palette_press)
        return button

    def draw_rainbow(self, widget, cr):
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        r = min(w, h) / 2 - 1
        for i in range(36):
            a0, a1 = i * math.pi / 18, (i + 1.2) * math.pi / 18
            cr.move_to(w / 2, h / 2)
            cr.arc(w / 2, h / 2, r, a0, a1)
            cr.close_path()
            rgb = colorsys.hsv_to_rgb(i / 36, 0.85, 1)
            cr.set_source_rgb(*rgb)
            cr.fill()
        return True

    # --- Tools and colors ---

    def set_tool(self, tool):
        self.finish_text()
        if tool != "select" and self.tool == "select":
            self.commit_floating()
            self.sel = None
        if self.tool not in ("picker", "zoom"):
            self.last_tool = self.tool
        self.tool = tool
        self.fill_size_combo()
        self.canvas.queue_draw()
        self.update_status()

    def fill_size_combo(self):
        combo = self.size_combo
        self.filling_combo = True
        combo.remove_all()
        if self.tool == "text":
            sizes, current = FONT_SIZES, self.font_size
            combo.set_tooltip_text("Font size")
            for s in sizes:
                combo.append_text(f"{s} pt")
        else:
            sizes, current = LINE_SIZES, self.line_size
            combo.set_tooltip_text("Line width")
            for s in sizes:
                combo.append_text(f"{s} px")
        combo.set_active(sizes.index(current))
        self.filling_combo = False

    def on_size_changed(self, combo):
        if self.filling_combo or combo.get_active() < 0:
            return
        if self.tool == "text":
            self.font_size = FONT_SIZES[combo.get_active()]
            self.canvas.queue_draw()
        else:
            self.line_size = LINE_SIZES[combo.get_active()]

    def set_color(self, slot, rgb):
        self.colors[slot] = rgb
        self.slot_swatches[slot].color = rgb
        self.slot_swatches[slot].queue_draw()
        self.canvas.queue_draw()

    def on_palette(self, button):
        rgb = button.get_child().color
        if rgb is None:
            self.edit_colors()
        else:
            self.set_color(self.color_slot, rgb)

    def on_palette_press(self, button, event):
        rgb = button.get_child().color
        if event.button == 3 and rgb is not None:  # right-click sets Color 2, like Paint
            self.set_color(1, rgb)
            return True
        return False

    def edit_colors(self):
        dialog = Gtk.ColorChooserDialog(title="Edit colors", transient_for=self)
        dialog.set_use_alpha(False)
        dialog.set_rgba(Gdk.RGBA(*self.colors[self.color_slot], 1))
        if dialog.run() == Gtk.ResponseType.OK:
            c = dialog.get_rgba()
            rgb = (c.red, c.green, c.blue)
            self.set_color(self.color_slot, rgb)
            self.custom_colors = ([rgb] + [x for x in self.custom_colors if x != rgb])[:10]
            for b, color in zip(self.custom_buttons, self.custom_colors):
                b.get_child().color = color
                b.get_child().queue_draw()
        dialog.destroy()

    # --- Picture state ---

    def size(self):
        return self.surface.get_width(), self.surface.get_height()

    def checkpoint(self):
        """Saves the picture for Undo. Call before every change."""
        self.undo_stack.append(copy_surface(self.surface))
        del self.undo_stack[:-UNDO_LEVELS]
        self.redo_stack.clear()
        self.set_modified()

    def set_modified(self):
        if not self.modified:
            self.modified = True
            self.update_title()

    def replace_surface(self, surface):
        self.surface = surface
        self.update_canvas_size()

    def undo(self):
        self.finish_text(commit=False)
        if self.floating is not None and self.drag is None:
            # A paste or a moved selection that isn't placed yet: undo it.
            self.floating = None
            self.sel = None
        if not self.undo_stack:
            self.canvas.queue_draw()
            return
        self.redo_stack.append(self.surface)
        self.sel = None
        self.replace_surface(self.undo_stack.pop())
        self.set_modified()

    def redo(self):
        if not self.redo_stack:
            return
        self.commit_floating()
        self.sel = None
        self.undo_stack.append(self.surface)
        self.replace_surface(self.redo_stack.pop())
        self.set_modified()

    def update_title(self):
        name = os.path.basename(self.path) if self.path else "Untitled"
        self.set_title(f"{name} - Paint")

    def update_canvas_size(self):
        w, h = self.size()
        self.canvas.set_size_request(int(w * self.zoom) + HANDLE + 4, int(h * self.zoom) + HANDLE + 4)
        self.canvas.queue_draw()
        self.update_status()

    def update_status(self):
        w, h = self.size()
        self.size_label.set_text(f"{w} × {h}px")
        if self.sel:
            self.sel_label.set_text(f"{self.sel[2]} × {self.sel[3]}px")
        else:
            self.sel_label.set_text("")
        self.zoom_label.set_text(f"{round(self.zoom * 100)}%")

    # --- Zoom ---

    def set_zoom(self, zoom):
        self.zoom = zoom
        self.update_canvas_size()

    def step_zoom(self, direction):
        if direction > 0:
            bigger = [z for z in ZOOMS if z > self.zoom]
            self.set_zoom(bigger[0] if bigger else self.zoom)
        else:
            smaller = [z for z in ZOOMS if z < self.zoom]
            self.set_zoom(smaller[-1] if smaller else self.zoom)

    def on_scroll(self, _w, event):
        if not event.state & Gdk.ModifierType.CONTROL_MASK:
            return False
        if event.direction == Gdk.ScrollDirection.UP:
            self.step_zoom(1)
        elif event.direction == Gdk.ScrollDirection.DOWN:
            self.step_zoom(-1)
        elif event.direction == Gdk.ScrollDirection.SMOOTH:
            _ok, _dx, dy = event.get_scroll_deltas()
            if dy:
                self.step_zoom(-1 if dy > 0 else 1)
        return True

    # --- Drawing the canvas ---

    def on_draw(self, _w, cr):
        w, h = self.size()
        z = self.zoom
        cr.save()
        cr.rectangle(0, 0, w * z, h * z)
        cr.clip()
        cr.scale(z, z)
        cr.set_source_surface(self.surface, 0, 0)
        if z >= 2:
            cr.get_source().set_filter(cairo.FILTER_NEAREST)
        cr.paint()
        if self.floating is not None:
            cr.set_source_surface(self.floating, self.sel[0], self.sel[1])
            if z >= 2:
                cr.get_source().set_filter(cairo.FILTER_NEAREST)
            cr.paint()
        if self.preview:
            self.draw_shape(cr, *self.preview)
        if self.text:
            self.draw_text(cr)
        cr.restore()

        cr.set_line_width(1)
        if self.sel and self.sel[2] and self.sel[3]:
            x, y, sw, sh = self.sel
            self.dashed_rect(cr, x * z, y * z, sw * z, sh * z)
        if self.text:
            t = self.text
            self.dashed_rect(cr, t["x"] * z, t["y"] * z, t["w"] * z, self.text_height() * z)

        # Canvas resize handles: right edge, bottom edge, corner.
        if self.drag and self.drag["kind"] == "resize-canvas":
            nw, nh = self.drag["size"]
            self.dashed_rect(cr, 0, 0, nw * z, nh * z)
        cr.set_source_rgb(0.85, 0.85, 0.87)
        for hx, hy in self.handle_points():
            cr.rectangle(hx, hy, HANDLE, HANDLE)
        cr.fill()

    def dashed_rect(self, cr, x, y, w, h):
        cr.rectangle(int(x) + 0.5, int(y) + 0.5, int(w), int(h))
        cr.set_source_rgb(1, 1, 1)
        cr.set_dash([])
        cr.stroke_preserve()
        cr.set_source_rgb(0, 0.47, 0.84)
        cr.set_dash([4, 4])
        cr.stroke()
        cr.set_dash([])

    def handle_points(self):
        w, h = self.size()
        x, y = w * self.zoom, h * self.zoom
        return [(x + 1, y / 2 - HANDLE / 2), (x / 2 - HANDLE / 2, y + 1), (x + 1, y + 1)]

    def handle_at(self, sx, sy):
        for i, (hx, hy) in enumerate(self.handle_points()):
            if hx - 2 <= sx <= hx + HANDLE + 2 and hy - 2 <= sy <= hy + HANDLE + 2:
                return ("x", "y", "xy")[i]
        return None

    def draw_shape(self, cr, kind, x0, y0, x1, y1, outline, fill, width):
        # Odd widths sit on pixel centers so edges stay sharp, like Paint.
        off = 0.5 if width % 2 else 0
        x0, y0, x1, y1 = (round(v) + off for v in (x0, y0, x1, y1))
        cr.save()
        cr.set_line_width(width)
        cr.set_line_join(cairo.LINE_JOIN_ROUND if kind in ("rounded", "ellipse") else cairo.LINE_JOIN_MITER)
        cr.set_line_cap(cairo.LINE_CAP_ROUND if kind == "line" else cairo.LINE_CAP_BUTT)
        shape_path(cr, kind, x0, y0, x1, y1)
        if fill is not None and kind != "line":
            cr.set_source_rgb(*fill)
            cr.fill_preserve()
        cr.set_source_rgb(*outline)
        cr.stroke()
        cr.restore()

    # --- Text ---

    def text_layout(self, cr):
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription(f"Sans {self.font_size}"))
        layout.set_width(max(1, int(self.text["w"])) * Pango.SCALE)
        layout.set_wrap(Pango.WrapMode.WORD_CHAR)
        layout.set_text(self.text["s"], -1)
        return layout

    def text_height(self):
        cr = cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1))
        _w, h = self.text_layout(cr).get_pixel_size()
        return max(h, self.text["min_h"])

    def draw_text(self, cr):
        t = self.text
        cr.save()
        cr.translate(t["x"], t["y"])
        layout = self.text_layout(cr)
        cr.set_source_rgb(*t["color"])
        PangoCairo.show_layout(cr, layout)
        # Blinking isn't worth the code; a steady caret shows where typing goes.
        pos = layout.get_cursor_pos(len(t["s"].encode()))[0]
        cr.rectangle(pos.x / Pango.SCALE, pos.y / Pango.SCALE, 1, max(pos.height / Pango.SCALE, 8))
        cr.fill()
        cr.restore()

    def start_text(self, x, y, w=None, h=None, color=None):
        self.text = {"x": x, "y": y, "w": max(w or 220, 40), "min_h": max(h or 0, 10), "s": "",
                     "color": color or self.colors[0]}
        self.canvas.grab_focus()
        self.canvas.queue_draw()

    def finish_text(self, commit=True):
        if not self.text:
            return
        if commit and self.text["s"].strip():
            self.checkpoint()
            cr = cairo.Context(self.surface)
            self.draw_text_final(cr)
        self.text = None
        self.canvas.queue_draw()

    def draw_text_final(self, cr):
        t = self.text
        cr.translate(t["x"], t["y"])
        cr.set_source_rgb(*t["color"])
        PangoCairo.show_layout(cr, self.text_layout(cr))

    # --- Selection and floating pixels ---

    def commit_floating(self):
        if self.floating is None:
            return
        cr = cairo.Context(self.surface)
        cr.set_source_surface(self.floating, self.sel[0], self.sel[1])
        cr.paint()
        self.floating = None
        self.sel = None
        self.set_modified()
        self.canvas.queue_draw()
        self.update_status()

    def lift_selection(self):
        """Turns the selected pixels into a floating piece that can be moved."""
        x, y, w, h = self.sel
        self.checkpoint()
        self.floating = copy_surface(self.surface, x, y, w, h)
        cr = cairo.Context(self.surface)
        cr.set_source_rgb(*self.colors[1])
        cr.rectangle(x, y, w, h)
        cr.fill()

    def clamp_sel(self):
        w, h = self.size()
        x, y, sw, sh = self.sel
        x0, y0 = max(0, min(x, x + sw)), max(0, min(y, y + sh))
        x1, y1 = min(w, max(x, x + sw)), min(h, max(y, y + sh))
        self.sel = [x0, y0, x1 - x0, y1 - y0] if x1 > x0 and y1 > y0 else None

    def selected_surface(self):
        if self.floating is not None:
            return self.floating
        if self.sel:
            return copy_surface(self.surface, *self.sel)
        return None

    def select_all(self):
        self.finish_text()
        self.commit_floating()
        self.tool_buttons["select"].set_active(True)
        self.sel = [0, 0, *self.size()]
        self.canvas.queue_draw()
        self.update_status()

    def delete_selection(self):
        if self.text:
            return
        if self.floating is not None:
            self.floating = None
        elif self.sel:
            self.checkpoint()
            cr = cairo.Context(self.surface)
            cr.set_source_rgb(*self.colors[1])
            cr.rectangle(*self.sel)
            cr.fill()
        self.sel = None
        self.canvas.queue_draw()
        self.update_status()

    def copy(self):
        piece = self.selected_surface()
        if piece is not None:
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clipboard.set_image(surface_to_pixbuf(piece))
            clipboard.store()

    def cut(self):
        if self.selected_surface() is None:
            return
        self.copy()
        self.delete_selection()

    def paste(self):
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        if self.text:
            clipboard.request_text(self.on_paste_text)
            return
        clipboard.request_image(self.on_paste_image)

    def on_paste_text(self, _clipboard, text):
        if text and self.text:
            self.text["s"] += text
            self.canvas.queue_draw()

    def on_paste_image(self, _clipboard, pixbuf):
        if pixbuf is None:
            return
        self.commit_floating()
        piece = pixbuf_to_surface(pixbuf)
        pw, ph = piece.get_width(), piece.get_height()
        w, h = self.size()
        self.checkpoint()
        if pw > w or ph > h:  # like Paint: make the picture big enough to hold it
            bigger = new_surface(max(w, pw), max(h, ph), self.colors[1])
            cr = cairo.Context(bigger)
            cr.set_source_surface(self.surface, 0, 0)
            cr.paint()
            self.replace_surface(bigger)
        # Put it at the top-left of what's on screen.
        x = int(self.scroller.get_hadjustment().get_value() / self.zoom)
        y = int(self.scroller.get_vadjustment().get_value() / self.zoom)
        w, h = self.size()
        x, y = max(0, min(x, w - pw)), max(0, min(y, h - ph))
        self.tool_buttons["select"].set_active(True)
        self.floating = piece
        self.sel = [x, y, pw, ph]
        self.canvas.queue_draw()
        self.update_status()

    # --- Image commands ---

    def crop(self):
        self.finish_text()
        if not self.sel:
            return
        if self.floating is None:
            self.checkpoint()
            piece = copy_surface(self.surface, *self.sel)
        else:
            piece = copy_surface(self.floating)
            self.floating = None
        self.sel = None
        self.replace_surface(piece)

    def transform(self, op):
        self.finish_text()
        self.commit_floating()
        self.sel = None
        w, h = self.size()
        nw, nh = (h, w) if op in ("right", "left") else (w, h)
        out = cairo.ImageSurface(cairo.FORMAT_ARGB32, nw, nh)
        cr = cairo.Context(out)
        if op == "right":
            cr.translate(nw, 0)
            cr.rotate(math.pi / 2)
        elif op == "left":
            cr.translate(0, nh)
            cr.rotate(-math.pi / 2)
        elif op == "180":
            cr.translate(nw, nh)
            cr.rotate(math.pi)
        elif op == "flip-h":
            cr.translate(nw, 0)
            cr.scale(-1, 1)
        elif op == "flip-v":
            cr.translate(0, nh)
            cr.scale(1, -1)
        cr.set_source_surface(self.surface, 0, 0)
        cr.paint()
        self.checkpoint()
        self.replace_surface(out)

    def resize_dialog(self):
        self.finish_text()
        self.commit_floating()
        w, h = self.size()
        dialog = Gtk.Dialog(title="Resize", transient_for=self, modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=8, column_spacing=12, margin=16)
        by_percent = Gtk.RadioButton(label="Percentage")
        by_pixels = Gtk.RadioButton.new_with_label_from_widget(by_percent, "Pixels")
        modes = Gtk.Box(spacing=12)
        modes.pack_start(Gtk.Label(label="By:"), False, False, 0)
        modes.pack_start(by_percent, False, False, 0)
        modes.pack_start(by_pixels, False, False, 0)
        grid.attach(modes, 0, 0, 2, 1)
        horiz = Gtk.SpinButton.new_with_range(1, 20000, 1)
        vert = Gtk.SpinButton.new_with_range(1, 20000, 1)
        horiz.set_activates_default(True)
        vert.set_activates_default(True)
        keep = Gtk.CheckButton(label="Keep aspect ratio", active=True)
        grid.attach(Gtk.Label(label="Horizontal:", xalign=0), 0, 1, 1, 1)
        grid.attach(horiz, 1, 1, 1, 1)
        grid.attach(Gtk.Label(label="Vertical:", xalign=0), 0, 2, 1, 1)
        grid.attach(vert, 1, 2, 1, 1)
        grid.attach(keep, 0, 3, 2, 1)
        dialog.get_content_area().add(grid)
        busy = [False]

        def set_mode(*_):
            busy[0] = True
            if by_percent.get_active():
                horiz.set_value(100)
                vert.set_value(100)
            else:
                horiz.set_value(w)
                vert.set_value(h)
            busy[0] = False

        def linked(src, dst, ratio):
            if busy[0] or not keep.get_active():
                return
            busy[0] = True
            dst.set_value(round(src.get_value() * ratio))
            busy[0] = False

        by_percent.connect("toggled", set_mode)
        horiz.connect("value-changed", lambda s: linked(
            s, vert, 1 if by_percent.get_active() else h / w))
        vert.connect("value-changed", lambda s: linked(
            s, horiz, 1 if by_percent.get_active() else w / h))
        set_mode()
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK:
            if by_percent.get_active():
                nw, nh = round(w * horiz.get_value() / 100), round(h * vert.get_value() / 100)
            else:
                nw, nh = int(horiz.get_value()), int(vert.get_value())
            nw, nh = max(1, nw), max(1, nh)
            if (nw, nh) != (w, h):
                out = cairo.ImageSurface(cairo.FORMAT_ARGB32, nw, nh)
                cr = cairo.Context(out)
                cr.scale(nw / w, nh / h)
                cr.set_source_surface(self.surface, 0, 0)
                cr.get_source().set_filter(cairo.FILTER_GOOD)
                cr.paint()
                self.checkpoint()
                self.sel = None
                self.replace_surface(out)
        dialog.destroy()

    def resize_canvas(self, nw, nh):
        self.checkpoint()
        out = new_surface(nw, nh, (1, 1, 1))
        cr = cairo.Context(out)
        cr.set_source_surface(self.surface, 0, 0)
        cr.paint()
        self.sel = None
        self.replace_surface(out)

    def flood_fill(self, x, y, rgb):
        s = self.surface
        s.flush()
        w, h = self.size()
        stride = s.get_stride() // 4
        data = s.get_data().cast("I")
        target = data[y * stride + x]
        color = pixel_value(rgb)
        if target == color:
            return False
        stack = [(x, y)]
        while stack:
            x, y = stack.pop()
            row = y * stride
            if data[row + x] != target:
                continue
            left = x
            while left > 0 and data[row + left - 1] == target:
                left -= 1
            right = x
            while right < w - 1 and data[row + right + 1] == target:
                right += 1
            data[row + left:row + right + 1] = array.array("I", [color]) * (right - left + 1)
            for ny in (y - 1, y + 1):
                if not 0 <= ny < h:
                    continue
                nrow = ny * stride
                i = left
                while i <= right:
                    if data[nrow + i] == target:
                        stack.append((i, ny))
                        while i <= right and data[nrow + i] == target:
                            i += 1
                    i += 1
        s.mark_dirty()
        return True

    def pick_color(self, x, y):
        s = self.surface
        s.flush()
        value = s.get_data().cast("I")[y * (s.get_stride() // 4) + x]
        a = (value >> 24) & 0xFF
        if a == 0:
            return (1, 1, 1)
        return tuple(min(1, ((value >> shift) & 0xFF) / a) for shift in (16, 8, 0))

    # --- Mouse ---

    def to_image(self, event):
        return event.x / self.zoom, event.y / self.zoom

    def stroke_segment(self, x0, y0, x1, y1):
        tool, color = self.drag["tool"], self.drag["color"]
        cr = cairo.Context(self.surface)
        cr.set_source_rgb(*color)
        if tool == "brush":
            cr.set_line_width(self.line_size + 1)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
        else:
            cr.set_antialias(cairo.ANTIALIAS_NONE)
            cr.set_line_cap(cairo.LINE_CAP_SQUARE)
            cr.set_line_width(max(4, self.line_size * 4) if tool == "eraser" else self.line_size)
            # Snap to pixel centers so 1px lines stay crisp.
            x0, y0, x1, y1 = (int(v) + 0.5 for v in (x0, y0, x1, y1))
        cr.move_to(x0, y0)
        cr.line_to(x1, y1)
        cr.stroke()
        self.canvas.queue_draw()

    def on_press(self, _w, event):
        self.canvas.grab_focus()
        if event.type != Gdk.EventType.BUTTON_PRESS or event.button not in (1, 3):
            return True
        x, y = self.to_image(event)
        w, h = self.size()
        ix, iy = int(x), int(y)
        inside = 0 <= ix < w and 0 <= iy < h
        main = event.button == 1
        color = self.colors[0] if main else self.colors[1]
        other = self.colors[1] if main else self.colors[0]

        handle = self.handle_at(event.x, event.y)
        if handle and main:
            self.finish_text()
            self.commit_floating()
            self.drag = {"kind": "resize-canvas", "axes": handle, "size": (w, h)}
            return True

        tool = self.tool
        if tool == "select":
            if self.sel and self.sel[0] <= x < self.sel[0] + self.sel[2] \
                    and self.sel[1] <= y < self.sel[1] + self.sel[3]:
                if self.floating is None:
                    self.lift_selection()
                self.drag = {"kind": "move", "dx": x - self.sel[0], "dy": y - self.sel[1]}
            else:
                self.commit_floating()
                self.sel = None
                self.drag = {"kind": "select", "x0": ix, "y0": iy}
            self.canvas.queue_draw()
            return True
        if tool == "text":
            t = self.text
            if t and t["x"] <= x <= t["x"] + t["w"] and t["y"] <= y <= t["y"] + self.text_height():
                return True
            if t:
                self.finish_text()  # clicking outside the box places the text, like Paint
                return True
            self.drag = {"kind": "text", "x0": x, "y0": y, "x1": x, "y1": y, "color": color}
            return True
        if tool == "zoom":
            self.step_zoom(1 if main else -1)
            return True
        if not inside and tool in ("fill", "picker"):
            return True
        if tool == "picker":
            self.set_color(0 if main else 1, self.pick_color(ix, iy))
            self.tool_buttons[self.last_tool].set_active(True)
            return True
        if tool == "fill":
            before = copy_surface(self.surface)
            if self.flood_fill(ix, iy, color):
                self.undo_stack.append(before)
                del self.undo_stack[:-UNDO_LEVELS]
                self.redo_stack.clear()
                self.set_modified()
                self.canvas.queue_draw()
            return True
        if tool.startswith("shape:"):
            fill = other if self.shape_fill else None
            self.drag = {"kind": "shape", "x0": x, "y0": y}
            self.preview = (tool[6:], x, y, x, y, color, fill, self.line_size)
            return True
        # pencil, brush, eraser
        if tool == "eraser":
            color = self.colors[1]
        self.checkpoint()
        self.drag = {"kind": "stroke", "tool": tool, "color": color, "x": x, "y": y}
        self.stroke_segment(x, y, x, y)
        return True

    def on_motion(self, _w, event):
        x, y = self.to_image(event)
        w, h = self.size()
        if 0 <= x < w and 0 <= y < h:
            self.pos_label.set_text(f"{int(x)}, {int(y)}px")
        else:
            self.pos_label.set_text("")
        handle = self.handle_at(event.x, event.y)
        cursor = {"x": "e-resize", "y": "s-resize", "xy": "se-resize"}.get(handle, "crosshair")
        if self.tool == "select" and self.sel and not handle and self.sel[0] <= x < self.sel[0] + self.sel[2] \
                and self.sel[1] <= y < self.sel[1] + self.sel[3]:
            cursor = "move"
        if self.tool == "text" and not handle:
            cursor = "text"
        window = self.canvas.get_window()
        window.set_cursor(Gdk.Cursor.new_from_name(window.get_display(), cursor))

        d = self.drag
        if not d:
            return True
        shift = event.state & Gdk.ModifierType.SHIFT_MASK
        if d["kind"] == "stroke":
            self.stroke_segment(d["x"], d["y"], x, y)
            d["x"], d["y"] = x, y
        elif d["kind"] == "shape":
            kind, x0, y0, _x1, _y1, color, fill, width = self.preview
            if shift:
                x, y = self.constrain(kind, x0, y0, x, y)
            self.preview = (kind, x0, y0, x, y, color, fill, width)
        elif d["kind"] == "select":
            self.sel = [d["x0"], d["y0"], int(round(x)) - d["x0"], int(round(y)) - d["y0"]]
            self.sel_label.set_text(f"{abs(self.sel[2])} × {abs(self.sel[3])}px")
        elif d["kind"] == "move":
            self.sel[0], self.sel[1] = int(round(x - d["dx"])), int(round(y - d["dy"]))
        elif d["kind"] == "text":
            d["x1"], d["y1"] = x, y
        elif d["kind"] == "resize-canvas":
            nw = max(1, int(round(x))) if "x" in d["axes"] else w
            nh = max(1, int(round(y))) if "y" in d["axes"] else h
            d["size"] = (nw, nh)
            self.size_label.set_text(f"{nw} × {nh}px")
        self.canvas.queue_draw()
        return True

    def constrain(self, kind, x0, y0, x, y):
        dx, dy = x - x0, y - y0
        if kind == "line":
            angle = round(math.atan2(dy, dx) / (math.pi / 4)) * (math.pi / 4)
            length = math.hypot(dx, dy)
            return x0 + length * math.cos(angle), y0 + length * math.sin(angle)
        side = max(abs(dx), abs(dy))
        return x0 + math.copysign(side, dx or 1), y0 + math.copysign(side, dy or 1)

    def on_release(self, _w, event):
        d, self.drag = self.drag, None
        if not d:
            return True
        if d["kind"] == "shape" and self.preview:
            kind, x0, y0, x1, y1 = self.preview[:5]
            if abs(x1 - x0) >= 1 or abs(y1 - y0) >= 1:
                self.checkpoint()
                self.draw_shape(cairo.Context(self.surface), *self.preview)
            self.preview = None
        elif d["kind"] == "select" and self.sel:
            self.clamp_sel()
        elif d["kind"] == "text":
            x0, y0 = min(d["x0"], d["x1"]), min(d["y0"], d["y1"])
            bw, bh = abs(d["x1"] - d["x0"]), abs(d["y1"] - d["y0"])
            if bw < 10:
                bw, bh = None, None
            self.start_text(x0, y0, bw, bh, d["color"])
        elif d["kind"] == "resize-canvas" and d["size"] != self.size():
            self.resize_canvas(*d["size"])
        self.canvas.queue_draw()
        self.update_status()
        return True

    # --- Keyboard ---

    def on_key(self, _w, event):
        key = event.keyval
        if self.text:
            if key == Gdk.KEY_Escape:
                self.finish_text()
            elif key == Gdk.KEY_BackSpace:
                self.text["s"] = self.text["s"][:-1]
            elif key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self.text["s"] += "\n"
            elif not event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK):
                ch = chr(Gdk.keyval_to_unicode(key)) if Gdk.keyval_to_unicode(key) else ""
                if ch and ch.isprintable():
                    self.text["s"] += ch
                else:
                    return False
            else:
                return False
            self.canvas.queue_draw()
            return True
        if key == Gdk.KEY_Escape and (self.sel or self.floating is not None):
            self.commit_floating()
            self.sel = None
            self.canvas.queue_draw()
            self.update_status()
            return True
        if key in (Gdk.KEY_Delete, Gdk.KEY_KP_Delete):
            self.delete_selection()
            return True
        return False

    # --- Files ---

    def load(self, path):
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
        except GLib.Error as e:
            self.message(f"Paint can't open {os.path.basename(path)}.", e.message)
            return False
        pixbuf = pixbuf.apply_embedded_orientation() or pixbuf
        self.surface = pixbuf_to_surface(pixbuf)
        self.path = os.path.abspath(path)
        self.modified = False
        self.undo_stack.clear()
        self.redo_stack.clear()
        self.sel = self.floating = self.text = None
        self.update_title()
        self.update_canvas_size()
        return True

    def write(self, path):
        self.finish_text()
        self.commit_floating()
        ext = os.path.splitext(path)[1].lower()
        try:
            if ext in (".jpg", ".jpeg"):
                surface_to_pixbuf(self.surface, flatten=True).savev(path, "jpeg", ["quality"], ["92"])
            elif ext == ".bmp":
                surface_to_pixbuf(self.surface, flatten=True).savev(path, "bmp", [], [])
            else:
                self.surface.write_to_png(path)
        except (GLib.Error, OSError, cairo.Error) as e:
            self.message(f"Paint can't save {os.path.basename(path)}.", str(e))
            return False
        self.path = path
        self.modified = False
        self.update_title()
        return True

    def save(self):
        if self.path and os.path.splitext(self.path)[1].lower() in (".png", ".jpg", ".jpeg", ".bmp"):
            return self.write(self.path)
        return self.save_as()

    def save_as(self):
        dialog = Gtk.FileChooserDialog(title="Save as", transient_for=self,
                                       action=Gtk.FileChooserAction.SAVE)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.ACCEPT)
        dialog.set_do_overwrite_confirmation(True)
        pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or os.path.expanduser("~")
        if self.path:
            dialog.set_filename(self.path)
        else:
            dialog.set_current_folder(pictures)
            dialog.set_current_name("Untitled.png")
        for name, pattern in [("PNG (*.png)", "*.png"), ("JPEG (*.jpg)", "*.jpg"), ("BMP (*.bmp)", "*.bmp")]:
            f = Gtk.FileFilter()
            f.set_name(name)
            f.add_pattern(pattern)
            dialog.add_filter(f)
        saved = False
        if dialog.run() == Gtk.ResponseType.ACCEPT:
            path = dialog.get_filename()
            if os.path.splitext(path)[1].lower() not in (".png", ".jpg", ".jpeg", ".bmp"):
                chosen = dialog.get_filter().get_name()
                path += ".jpg" if "JPEG" in chosen else ".bmp" if "BMP" in chosen else ".png"
            saved = self.write(path)
        dialog.destroy()
        return saved

    def open_dialog(self):
        if not self.confirm_discard():
            return
        dialog = Gtk.FileChooserDialog(title="Open", transient_for=self, action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.ACCEPT)
        f = Gtk.FileFilter()
        f.set_name("Pictures")
        f.add_pixbuf_formats()
        dialog.add_filter(f)
        pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
        if pictures and os.path.isdir(pictures):
            dialog.set_current_folder(pictures)
        if dialog.run() == Gtk.ResponseType.ACCEPT:
            self.load(dialog.get_filename())
        dialog.destroy()

    def new(self):
        if not self.confirm_discard():
            return
        self.surface = new_surface(*DEFAULT_SIZE)
        self.path = None
        self.modified = False
        self.undo_stack.clear()
        self.redo_stack.clear()
        self.sel = self.floating = self.text = None
        self.update_title()
        self.update_canvas_size()

    def confirm_discard(self):
        """Asks to save unsaved changes. False means the user cancelled."""
        if self.text and self.text["s"].strip():
            self.finish_text()
        if self.floating is not None:
            self.commit_floating()
        if not self.modified:
            return True
        name = os.path.basename(self.path) if self.path else "Untitled"
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   text=f"Do you want to save changes to {name}?")
        dialog.add_buttons("Don't save", Gtk.ResponseType.NO, "Cancel", Gtk.ResponseType.CANCEL,
                           "Save", Gtk.ResponseType.YES)
        dialog.set_default_response(Gtk.ResponseType.YES)
        answer = dialog.run()
        dialog.destroy()
        if answer == Gtk.ResponseType.YES:
            return self.save()
        return answer == Gtk.ResponseType.NO

    def on_delete(self, *_):
        return not self.confirm_discard()

    def message(self, text, detail):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
                                   buttons=Gtk.ButtonsType.OK, text=text, secondary_text=detail)
        dialog.run()
        dialog.destroy()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.skornex.Paint",
                         flags=Gio.ApplicationFlags.HANDLES_OPEN | Gio.ApplicationFlags.NON_UNIQUE)

    def do_startup(self):
        Gtk.Application.do_startup(self)
        Gtk.Settings.get_default().props.gtk_application_prefer_dark_theme = True
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        for action, keys in [("new", ["<Ctrl>n"]), ("open", ["<Ctrl>o"]), ("save", ["<Ctrl>s"]),
                             ("save-as", ["<Ctrl><Shift>s", "F12"]), ("undo", ["<Ctrl>z"]),
                             ("redo", ["<Ctrl>y", "<Ctrl><Shift>z"]), ("cut", ["<Ctrl>x"]),
                             ("copy", ["<Ctrl>c"]), ("paste", ["<Ctrl>v"]),
                             ("select-all", ["<Ctrl>a"]),
                             ("zoom-in", ["<Ctrl>plus", "<Ctrl>equal", "<Ctrl>KP_Add"]),
                             ("zoom-out", ["<Ctrl>minus", "<Ctrl>KP_Subtract"]),
                             ("zoom-reset", ["<Ctrl>0"])]:
            self.set_accels_for_action("win." + action, keys)

    def do_activate(self):
        PaintWindow(self).show_all()

    def do_open(self, files, _n, _hint):
        for f in files:
            PaintWindow(self, f.get_path()).show_all()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
