.ribbon { background-color: #18181b; border-bottom: 1px solid #2c2c31; padding: 2px 6px 4px 6px; }
.ribbon button { min-height: 0; min-width: 0; padding: 4px; border: none;
                 background: none; box-shadow: none; border-radius: 4px; }
.ribbon button:hover { background-color: rgba(255, 255, 255, 0.08); }
.ribbon button:checked { background-color: rgba(255, 255, 255, 0.16); }
.ribbon button.big { padding: 6px 8px; }
.ribbon combobox button { padding: 2px 6px; background-color: rgba(255, 255, 255, 0.06); }
