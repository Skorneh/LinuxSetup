#!/usr/bin/env python3
"""SkorneX Paint: a simple picture editor that works like Microsoft Paint.

    skornex-paint             open a blank picture (or search "Paint")
    skornex-paint FILE        open a picture

Like Paint:
  - Ctrl+V pastes a screenshot (or any copied picture). Drag it where you
    want it, then click outside it.
  - Left click draws with Color 1, right click with Color 2.
  - Selection, Crop, Resize, Rotate, Pencil, Fill, Text, Eraser, Color
    picker, Magnifier, Brush and Shapes, in a ribbon along the top.
  - Drag the little square at the bottom-right corner of the picture to make
    the canvas bigger or smaller.
  - Ctrl+S saves (PNG, JPEG or BMP), Ctrl+Z / Ctrl+Y undo and redo.
"""

import array
import colorsys
import faulthandler
import math
import os
import sys

import cairo
import gi

faulthandler.enable()

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango, PangoCairo  # noqa: E402

DEFAULT_SIZE = (1152, 648)
UNDO_LEVELS = 20
ZOOMS = [0.125, 0.25, 0.5, 0.75, 1, 1.5, 2, 3, 4, 6, 8]
HANDLE = 7  # size of the canvas resize handles, in screen pixels
ICON_FG = (0.86, 0.86, 0.88)

LINE_SIZES = [1, 3, 5, 8]
FONT_SIZES = [8, 10, 11, 12, 14, 16, 18, 20, 24, 28, 36, 48, 72]

# The classic Paint palette.
PALETTE = [
    "000000", "7f7f7f", "880015", "ed1c24", "ff7f27",
    "fff200", "22b14c", "00a2e8", "3f48cc", "a349a4",
    "ffffff", "c3c3c3", "b97a57", "ffaec9", "ffc90e",
    "efe4b0", "b5e61d", "99d9ea", "7092be", "c8bfe7",
]

SHAPES = [
    ("line", "Line"), ("rect", "Rectangle"), ("rounded", "Rounded rectangle"),
    ("ellipse", "Oval"), ("triangle", "Triangle"), ("right-triangle", "Right triangle"),
    ("diamond", "Diamond"), ("pentagon", "Pentagon"), ("hexagon", "Hexagon"),
    ("arrow-right", "Right arrow"), ("arrow-up", "Up arrow"), ("star", "Star"),
]


def regular(n, start=-math.pi / 2):
    return [(0.5 + 0.5 * math.cos(start + i * 2 * math.pi / n),
             0.5 + 0.5 * math.sin(start + i * 2 * math.pi / n)) for i in range(n)]


def star(points=5, inner=0.4):
    out = []
    for i in range(points * 2):
        r = 0.5 if i % 2 == 0 else 0.5 * inner
        a = -math.pi / 2 + i * math.pi / points
        out.append((0.5 + r * math.cos(a), 0.5 + r * math.sin(a)))
    return out


POLYGONS = {
    "triangle": [(0.5, 0), (1, 1), (0, 1)],
    "right-triangle": [(0, 0), (1, 1), (0, 1)],
    "diamond": [(0.5, 0), (1, 0.5), (0.5, 1), (0, 0.5)],
    "pentagon": regular(5),
    "hexagon": regular(6, 0),
    "arrow-right": [(0, 0.3), (0.55, 0.3), (0.55, 0), (1, 0.5), (0.55, 1), (0.55, 0.7), (0, 0.7)],
    "arrow-up": [(0.5, 0), (1, 0.45), (0.7, 0.45), (0.7, 1), (0.3, 1), (0.3, 0.45), (0, 0.45)],
    "star": star(),
}


def shape_path(cr, kind, x0, y0, x1, y1):
    """Adds a shape's outline to cr's path, fitted to the dragged box."""
    if kind == "line":
        cr.move_to(x0, y0)
        cr.line_to(x1, y1)
        return
    left, top = min(x0, x1), min(y0, y1)
    w, h = abs(x1 - x0), abs(y1 - y0)
    if kind == "rect":
        cr.rectangle(left, top, w, h)
    elif kind == "rounded":
        r = min(w, h) / 5
        cr.new_sub_path()
        cr.arc(left + w - r, top + r, r, -math.pi / 2, 0)
        cr.arc(left + w - r, top + h - r, r, 0, math.pi / 2)
        cr.arc(left + r, top + h - r, r, math.pi / 2, math.pi)
        cr.arc(left + r, top + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()
    elif kind == "ellipse":
        cr.save()
        cr.translate(left + w / 2, top + h / 2)
        cr.scale(max(w / 2, 0.01), max(h / 2, 0.01))
        cr.new_sub_path()
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
    else:
        pts = POLYGONS[kind]
        cr.move_to(left + pts[0][0] * w, top + pts[0][1] * h)
        for px, py in pts[1:]:
            cr.line_to(left + px * w, top + py * h)
        cr.close_path()


def hex_rgb(value):
    return tuple(int(value[i:i + 2], 16) / 255 for i in (0, 2, 4))


def new_surface(w, h, fill=(1, 1, 1)):
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    cr = cairo.Context(surface)
    cr.set_source_rgb(*fill)
    cr.paint()
    return surface


def copy_surface(src, x=0, y=0, w=None, h=None):
    w = src.get_width() if w is None else w
    h = src.get_height() if h is None else h
    out = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    cr = cairo.Context(out)
    cr.set_source_surface(src, -x, -y)
    cr.set_operator(cairo.OPERATOR_SOURCE)
    cr.paint()
    return out


def surface_to_pixbuf(surface, flatten=False):
    w, h = surface.get_width(), surface.get_height()
    if flatten:  # JPEG and BMP have no transparency: put it on white
        flat = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
        cr = cairo.Context(flat)
        cr.set_source_rgb(1, 1, 1)
        cr.paint()
        cr.set_source_surface(surface, 0, 0)
        cr.paint()
        surface = flat
    return Gdk.pixbuf_get_from_surface(surface, 0, 0, w, h)


def pixbuf_to_surface(pixbuf):
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, pixbuf.get_width(), pixbuf.get_height())
    cr = cairo.Context(surface)
    Gdk.cairo_set_source_pixbuf(cr, pixbuf, 0, 0)
    cr.paint()
    return surface


def pixel_value(rgb):
    """An opaque color as Cairo stores it in memory (0xAARRGGBB)."""
    r, g, b = (round(c * 255) for c in rgb)
    return 0xFF000000 | (r << 16) | (g << 8) | b


# --- Ribbon icons, drawn in code so they look the same on any icon theme ---

def icon_select(cr, s):
    cr.set_dash([2.5, 2])
    cr.rectangle(s * 0.15, s * 0.2, s * 0.7, s * 0.6)
    cr.stroke()


def icon_crop(cr, s):
    cr.move_to(s * 0.3, s * 0.1)
    cr.line_to(s * 0.3, s * 0.7)
    cr.line_to(s * 0.9, s * 0.7)
    cr.move_to(s * 0.1, s * 0.3)
    cr.line_to(s * 0.7, s * 0.3)
    cr.line_to(s * 0.7, s * 0.9)
    cr.stroke()


def icon_resize(cr, s):
    cr.rectangle(s * 0.1, s * 0.4, s * 0.5, s * 0.5)
    cr.move_to(s * 0.45, s * 0.55)
    cr.line_to(s * 0.9, s * 0.1)
    cr.move_to(s * 0.6, s * 0.1)
    cr.line_to(s * 0.9, s * 0.1)
    cr.line_to(s * 0.9, s * 0.4)
    cr.stroke()


def icon_rotate(cr, s):
    cr.arc(s * 0.5, s * 0.55, s * 0.32, math.pi * 1.05, math.pi * 2.3)
    cr.stroke()
    cr.move_to(s * 0.05, s * 0.35)
    cr.line_to(s * 0.18, s * 0.6)
    cr.line_to(s * 0.38, s * 0.42)
    cr.stroke()


def icon_pencil(cr, s):
    cr.move_to(s * 0.15, s * 0.85)
    cr.line_to(s * 0.25, s * 0.6)
    cr.line_to(s * 0.7, s * 0.15)
    cr.line_to(s * 0.85, s * 0.3)
    cr.line_to(s * 0.4, s * 0.75)
    cr.close_path()
    cr.stroke()


def icon_fill(cr, s):
    cr.move_to(s * 0.45, s * 0.1)
    cr.line_to(s * 0.8, s * 0.45)
    cr.line_to(s * 0.45, s * 0.8)
    cr.line_to(s * 0.1, s * 0.45)
    cr.close_path()
    cr.stroke()
    cr.arc(s * 0.85, s * 0.75, s * 0.08, 0, 2 * math.pi)
    cr.fill()


def icon_text(cr, s):
    cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
    cr.set_font_size(s * 0.9)
    ext = cr.text_extents("A")
    cr.move_to((s - ext.width) / 2 - ext.x_bearing, (s - ext.height) / 2 - ext.y_bearing)
    cr.show_text("A")


def icon_eraser(cr, s):
    cr.move_to(s * 0.1, s * 0.6)
    cr.line_to(s * 0.5, s * 0.2)
    cr.line_to(s * 0.85, s * 0.55)
    cr.line_to(s * 0.5, s * 0.9)
    cr.line_to(s * 0.4, s * 0.9)
    cr.close_path()
    cr.move_to(s * 0.28, s * 0.42)
    cr.line_to(s * 0.68, s * 0.82)
    cr.stroke()


def icon_picker(cr, s):
    cr.move_to(s * 0.15, s * 0.85)
    cr.line_to(s * 0.6, s * 0.4)
    cr.stroke()
    cr.arc(s * 0.72, s * 0.28, s * 0.14, 0, 2 * math.pi)
    cr.fill()


def icon_zoom(cr, s):
    cr.arc(s * 0.42, s * 0.42, s * 0.28, 0, 2 * math.pi)
    cr.move_to(s * 0.62, s * 0.62)
    cr.line_to(s * 0.9, s * 0.9)
    cr.stroke()


def icon_brush(cr, s):
    cr.move_to(s * 0.9, s * 0.1)
    cr.line_to(s * 0.45, s * 0.55)
    cr.stroke()
    cr.move_to(s * 0.5, s * 0.6)
    cr.curve_to(s * 0.3, s * 0.45, s * 0.1, s * 0.6, s * 0.12, s * 0.88)
    cr.curve_to(s * 0.35, s * 0.9, s * 0.55, s * 0.8, s * 0.5, s * 0.6)
    cr.fill()


def shape_icon(kind):
    def draw(cr, s):
        cr.set_line_width(1.3)
        if kind == "line":
            shape_path(cr, kind, s * 0.1, s * 0.9, s * 0.9, s * 0.1)
        else:
            shape_path(cr, kind, s * 0.1, s * 0.15, s * 0.9, s * 0.85)
        cr.stroke()
    return draw


class Icon(Gtk.DrawingArea):
    def __init__(self, painter, size=20):
        super().__init__()
        self.painter = painter
        self.size = size
        self.set_size_request(size, size)
        self.connect("draw", self.on_draw)

    def on_draw(self, _w, cr):
        cr.set_source_rgb(*ICON_FG)
        cr.set_line_width(1.5)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        self.painter(cr, self.size)


class Swatch(Gtk.DrawingArea):
    """A round color dot. color=None draws an empty ring (unused custom slot)."""

    def __init__(self, color, size=18):
        super().__init__()
        self.color = color
        self.set_size_request(size, size)
        self.connect("draw", self.on_draw)

    def on_draw(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        r = min(w, h) / 2 - 1
        cr.arc(w / 2, h / 2, r, 0, 2 * math.pi)
        if self.color is not None:
            cr.set_source_rgb(*self.color)
            cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.35)
        cr.set_line_width(1)
        cr.stroke()


CSS = b"""
