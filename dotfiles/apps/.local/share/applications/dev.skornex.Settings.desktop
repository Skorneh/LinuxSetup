[Desktop Entry]
# SkorneX Settings (skornex-settings): every Settings module you have, in one
# window. Named after the window's app ID so the taskbar finds its icon.
Type=Application
Name=Settings
Comment=All your SkorneX settings in one place, and add or remove settings modules
Exec=skornex-settings
Icon=preferences-system
StartupWMClass=dev.skornex.Settings
Categories=Settings;
Keywords=settings;control panel;preferences;options;modules;
