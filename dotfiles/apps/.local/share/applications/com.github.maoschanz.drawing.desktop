[Desktop Entry]
# Shows Drawing as "Paint" in search, the taskbar and Alt+Tab.
# A copy of Drawing's own entry with a new name; this one takes priority.
Name=Paint
GenericName=Paint
Comment=Draw and edit pictures, paste screenshots
Exec=drawing %U
Icon=com.github.maoschanz.drawing
Terminal=false
Type=Application
StartupNotify=true
Keywords=Paint;Drawing;Sketch;Pencil;Screenshot;
Categories=Graphics;GTK;
MimeType=image/png;image/bmp;image/jpeg;
Actions=new-window;new-tab;edit-clipboard;

[Desktop Action new-window]
Name=New Window
Exec=drawing --new-window

[Desktop Action new-tab]
Name=New Image
Exec=drawing --new-tab

[Desktop Action edit-clipboard]
Name=Edit Image in Clipboard
Exec=drawing --edit-clipboard
